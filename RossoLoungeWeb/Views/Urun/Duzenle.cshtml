@model RossoLoungeWeb.Models.Urun
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Ürün Düzenle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh; padding: 20px;">

    <div class="card shadow p-4" style="width: 100%; max-width: 600px;">
        <h4 class="mb-4 text-center">Ürün Düzenle</h4>

        <form action="/Urun/Duzenle" method="post" enctype="multipart/form-data">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Sıra No:</label>
                <input type="number" name="SiraNo" class="form-control" value="@Model.SiraNo" required>
                <small class="text-muted">Menüde kaçıncı sırada görünsün?</small>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Ürün Adı:</label>
                <input type="text" name="Ad" class="form-control" value="@Model.Ad" required>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Kategori:</label>
                @Html.DropDownList("KategoriId", (SelectList)ViewBag.Kategoriler, new { @class = "form-control" })
            </div>

            <div class="card bg-light border-0 mb-3 p-3">
                <h6 class="text-muted mb-3 border-bottom pb-2">Fiyatlandırma Seçenekleri</h6>

                <div class="row mb-2">
                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-bold">1. Fiyat (Zorunlu):</label>
                        <input type="text" name="Fiyat" class="form-control"
                               value="@Model.Fiyat.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-bold">2. Fiyat (Opsiyonel):</label>
                        <input type="text" name="FiyatBuyuk" class="form-control"
                               value="@(Model.FiyatBuyuk.HasValue? Model.FiyatBuyuk.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label small">1. Fiyat İsmi (Opsiyonel):</label>
                        <input type="text" name="FiyatTur" class="form-control form-control-sm" value="@Model.FiyatTur" placeholder="Örn: Orta, Kutu (Boşsa 'Orta')">
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label small">2. Fiyat İsmi (Opsiyonel):</label>
                        <input type="text" name="FiyatBuyukTur" class="form-control form-control-sm" value="@Model.FiyatBuyukTur" placeholder="Örn: Büyük, Şişe (Boşsa 'Büyük')">
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Açıklama:</label>
                <textarea name="Aciklama" class="form-control" rows="3">@Model.Aciklama</textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Yeni Resim (Opsiyonel):</label>
                <input type="file" name="ResimDosyasi" class="form-control" accept="image/*">

                @if (!string.IsNullOrEmpty(Model.ResimUrl))
                {
                    <div class="mt-2 p-2 border rounded bg-white d-inline-block">
                        <small class="d-block text-muted mb-1">Mevcut:</small>
                        <img src="@Model.ResimUrl" width="80" style="border-radius: 5px;" />
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Değişiklikleri Kaydet</button>
        </form>

        <a href="/Urun/Index" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
    </div>

</body>
</html>