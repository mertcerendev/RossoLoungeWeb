@model RossoLoungeWeb.Models.Urun
@*
    ÜRÜN DÜZENLE
    ===============================================================
    Uç değişmedi: POST /Urun/Duzenle, multipart (ResimDosyasi).
    Fiyatlar InvariantCulture ile basılıyor — alan metin girdisi
    olduğu için sunucunun okuduğu biçimle aynı olmalı.

    SIRA NO ALANI KALDIRILDI — gerekçe Ekle.cshtml'de. Burada ayrıca
    zararlıydı: kategorisinin 5. sırasındaki ürüne "1" yazmak
    diğerlerini kaydırmıyor, yalnızca ikinci bir 1 üretiyordu.
    Controller da artık SiraNo'ya dokunmuyor.

    Başlığın yanındaki rozet bir DÜĞME DEĞİL, bağlam: ürünün hangi
    kategoride olduğunu söylüyor ve o kategorinin listesine götürüyor.
    Eskiden orada duran "Listeye dön", formun altındaki "İptal" ile
    aynı işi yapıyordu.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Ürün Düzenle";
    // Doğrulama hatasında Model.Ad boş olabilir; o zaman kaydın adı
    // controller'dan geliyor, başlık "hangi ürün" bilgisini yitirmesin.
    ViewData["AltBaslik"] = string.IsNullOrWhiteSpace(Model.Ad)
        ? ViewBag.MevcutAd as string
        : Model.Ad;
    ViewData["Aktif"] = "urunler";

    var ik = System.Globalization.CultureInfo.InvariantCulture;
    var kategoriAdi = ViewBag.KategoriAdi as string;
}

@section Eylemler {
    @if (!string.IsNullOrEmpty(kategoriAdi))
    {
        <a class="y-rozet y-rozet--sonuk" href="/Urun/Index?kategoriId=@Model.KategoriId">
            @kategoriAdi
        </a>
    }
}

@await Html.PartialAsync("_YonetimDogrulama")

<form class="y-form" method="post" action="/Urun/Duzenle" enctype="multipart/form-data" data-ondalik-form>
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id">

    <div class="y-form__izgara">
        <div class="y-form__alan">
            <label class="y-form__etiket" for="ad">
                Ürün adı <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            <input class="y-girdi" type="text" id="ad" name="Ad" value="@Model.Ad"
                   maxlength="100" required autofocus>
        </div>

        <div class="y-form__alan">
            <label class="y-form__etiket" for="KategoriId">
                Kategori <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            @Html.DropDownList("KategoriId", (SelectList)ViewBag.Kategoriler,
                     new { @class = "y-girdi", required = "required", aria_describedby = "kategori-yardim" })
            <p class="y-form__yardim" id="kategori-yardim">
                Kategori değişirse ürün menüde yeni başlığın altına taşınır.
            </p>
        </div>
    </div>

    <fieldset class="y-alanlik">
        <legend class="y-alanlik__baslik">Fiyatlandırma</legend>

        <div class="y-form__izgara">
            <div class="y-form__alan">
                <label class="y-form__etiket" for="fiyat">
                    1. fiyat <span class="y-zorunlu" aria-hidden="true">*</span>
                </label>
                <input class="y-girdi y-girdi--sayi" type="text" id="fiyat" name="Fiyat" inputmode="decimal"
                       value="@Model.Fiyat.ToString("0.##", ik)" required data-ondalik>
            </div>

            <div class="y-form__alan">
                <label class="y-form__etiket" for="fiyatBuyuk">2. fiyat</label>
                <input class="y-girdi y-girdi--sayi" type="text" id="fiyatBuyuk" name="FiyatBuyuk" inputmode="decimal"
                       value="@(Model.FiyatBuyuk.HasValue ? Model.FiyatBuyuk.Value.ToString("0.##", ik) : "")" data-ondalik>
            </div>

            <div class="y-form__alan">
                <label class="y-form__etiket" for="fiyatTur">1. fiyat ismi</label>
                <input class="y-girdi" type="text" id="fiyatTur" name="FiyatTur"
                       value="@Model.FiyatTur" maxlength="50" placeholder="Boşsa 'Orta'">
            </div>

            <div class="y-form__alan">
                <label class="y-form__etiket" for="fiyatBuyukTur">2. fiyat ismi</label>
                <input class="y-girdi" type="text" id="fiyatBuyukTur" name="FiyatBuyukTur"
                       value="@Model.FiyatBuyukTur" maxlength="50" placeholder="Boşsa 'Büyük'">
            </div>
        </div>
    </fieldset>

    <div class="y-form__alan">
        <label class="y-form__etiket" for="aciklama">Açıklama</label>
        <textarea class="y-girdi" id="aciklama" name="Aciklama" rows="3" maxlength="1000">@Model.Aciklama</textarea>
    </div>

    <div class="y-form__alan">
        <label class="y-form__etiket" for="resimDosyasi">Yeni görsel</label>
        <input class="y-girdi" type="file" id="resimDosyasi" name="ResimDosyasi"
               accept="image/*" aria-describedby="resim-yardim">
        <p class="y-form__yardim" id="resim-yardim">
            JPG, PNG, WEBP veya GIF · en fazla 5 MB. Boş bırakırsanız mevcut görsel korunur.
        </p>

        @if (UrunGorseli.Gecerli(Model.ResimUrl))
        {
            <div class="y-onizleme">
                <img src="@Model.ResimUrl" alt="@Model.Ad ürününün mevcut görseli">
                <span class="y-form__yardim">Mevcut görsel</span>
            </div>
        }
        else
        {
            <p class="y-form__yardim">Bu ürünün görseli yok — menüde yer tutucu çıkıyor.</p>
        }
    </div>

    <div class="y-form__ayak">
        <button type="submit" class="y-dugme y-dugme--birincil">Değişikliği kaydet</button>
        <a class="y-dugme" href="/Urun/Index">Vazgeç</a>
    </div>
</form>
