@model RossoLoungeWeb.Models.Urun
@*
    ÜRÜN EKLE
    ===============================================================
    Uç değişmedi: POST /Urun/Ekle, multipart (ResimDosyasi).

    data-ondalik-form / data-ondalik: fiyat alanlarındaki virgül
    gönderimden hemen önce noktaya çevriliyor. Sunucuda ayrıca
    OndalikModelBinder var; bu, JS varken hatayı kullanıcı
    göndermeden düzelten ikinci katman.

    SIRA NO ALANI KALDIRILDI. Sıralamanın iki sahibi vardı: listedeki
    sürükle-bırak ve buradaki sayı kutusu. Elle girilen numara başka
    bir ürününkiyle çakışabiliyor, çakışınca menüdeki sıra belirsiz
    kalıyordu. Artık numarayı sunucu veriyor (sona ekleme), sırayı
    yönetici listede — kendi kategorisi seçiliyken — sürükleyerek
    değiştiriyor.

    DÜĞMELER FORMUN ALTINDA, tek yerde. Önceden sayfa başlığının
    yanında "Listeye dön", formun altında "İptal" vardı: aynı adrese
    giden iki düğme, biri üstte biri altta.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Yeni Ürün";
    ViewData["AltBaslik"] = "Menüye yeni bir kalem ekleyin";
    ViewData["Aktif"] = "urunler";
}

@await Html.PartialAsync("_YonetimDogrulama")

<form class="y-form" method="post" action="/Urun/Ekle" enctype="multipart/form-data" data-ondalik-form>
    @Html.AntiForgeryToken()

    @* Ad önce: sayfanın konusu bu. Kategori onun yanında —
       ürünün menüde nereye düşeceğini birlikte okuyorsun. *@
    <div class="y-form__izgara">
        <div class="y-form__alan">
            <label class="y-form__etiket" for="ad">
                Ürün adı <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            <input class="y-girdi" type="text" id="ad" name="Ad"
                   value="@Model.Ad" placeholder="Örn: Margherita" maxlength="100"
                   required autofocus>
        </div>

        <div class="y-form__alan">
            <label class="y-form__etiket" for="KategoriId">
                Kategori <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            @Html.DropDownList("KategoriId", (SelectList)ViewBag.Kategoriler, "Kategori seçiniz...",
                     new { @class = "y-girdi", required = "required", aria_describedby = "kategori-yardim" })
            <p class="y-form__yardim" id="kategori-yardim">
                Ürün bu kategorinin altına, listenin sonuna eklenir.
            </p>
        </div>
    </div>

    <fieldset class="y-alanlik">
        <legend class="y-alanlik__baslik">Fiyatlandırma</legend>

        <div class="y-form__izgara">
            <div class="y-form__alan">
                <label class="y-form__etiket" for="fiyat">
                    1. fiyat <span class="y-zorunlu" aria-hidden="true">*</span>
                </label>
                <input class="y-girdi y-girdi--sayi" type="text" id="fiyat" name="Fiyat"
                       inputmode="decimal" placeholder="0.00" required data-ondalik>
            </div>

            <div class="y-form__alan">
                <label class="y-form__etiket" for="fiyatBuyuk">2. fiyat</label>
                <input class="y-girdi y-girdi--sayi" type="text" id="fiyatBuyuk" name="FiyatBuyuk"
                       inputmode="decimal" placeholder="Sadece iki boyu varsa…" data-ondalik>
            </div>

            <div class="y-form__alan">
                <label class="y-form__etiket" for="fiyatTur">1. fiyat ismi</label>
                <input class="y-girdi" type="text" id="fiyatTur" name="FiyatTur"
                       maxlength="50" placeholder="Örn: Orta, Kutu">
            </div>

            <div class="y-form__alan">
                <label class="y-form__etiket" for="fiyatBuyukTur">2. fiyat ismi</label>
                <input class="y-girdi" type="text" id="fiyatBuyukTur" name="FiyatBuyukTur"
                       maxlength="50" placeholder="Örn: Büyük, Şişe">
            </div>
        </div>
    </fieldset>

    <div class="y-form__alan">
        <label class="y-form__etiket" for="aciklama">Açıklama (içindekiler)</label>
        <textarea class="y-girdi" id="aciklama" name="Aciklama" rows="3" maxlength="1000"
                  placeholder="Örn: Domates sos, mozzarella…">@Model.Aciklama</textarea>
    </div>

    <div class="y-form__alan">
        <label class="y-form__etiket" for="resimDosyasi">Ürün görseli</label>
        <input class="y-girdi" type="file" id="resimDosyasi" name="ResimDosyasi"
               accept="image/*" aria-describedby="resim-yardim">
        <p class="y-form__yardim" id="resim-yardim">
            JPG, PNG, WEBP veya GIF · en fazla 5 MB. Boş bırakırsanız menüde
            yer tutucu görsel çıkar.
        </p>
    </div>

    @* VİTRİN İŞARETİ — ana sayfadaki "Bu haftanın seçkileri" bölümü.
       Üç tabak alıyor (ızgara CSS'te üç sütun); sınır sunucuda.
       Aynı işaret Ürünler listesinde tek tıkla da açılıp kapanıyor. *@
    <div class="y-form__alan">
        <label class="y-onay" for="oneCikan">
            <input type="checkbox" id="oneCikan" name="OneCikan" value="true"
                   @(Model.OneCikan ? "checked" : null) aria-describedby="vitrin-yardim">
            Ana sayfada öne çıkar
        </label>
        <p class="y-form__yardim" id="vitrin-yardim">
            Ana sayfadaki vitrin üç tabak gösteriyor. Üçten az
            işaretlerseniz kalan yerler menü sırasına göre kendiliğinden
            dolar. Seçili olanları Ürünler listesinin başındaki "Vitrin"
            rozetinden görebilirsiniz.
        </p>
    </div>

    <div class="y-form__ayak">
        <button type="submit" class="y-dugme y-dugme--birincil">Ürünü ekle</button>
        <a class="y-dugme" href="/Urun/Index">Vazgeç</a>
    </div>
</form>
