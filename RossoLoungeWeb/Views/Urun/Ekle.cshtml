@model RossoLoungeWeb.Models.Urun
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Yeni Ürün Ekle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh; padding: 20px;">

    <div class="card shadow p-4" style="width: 100%; max-width: 600px;">
        <h4 class="mb-4 text-center">Yeni Yemek Ekle</h4>

        <form action="/Urun/Ekle" method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label fw-bold">Sıra No:</label>
                <input type="number" name="SiraNo" class="form-control" required value="@Model.SiraNo">
                <small class="text-muted">Menüde kaçıncı sırada görünsün?</small>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Kategori:</label>
                @Html.DropDownList("KategoriId", (SelectList)ViewBag.Kategoriler, "Kategori Seçiniz...", new { @class = "form-control", required = "required" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Ürün Adı:</label>
                <input type="text" name="Ad" class="form-control" required placeholder="Örn: Margherita">
            </div>

            <div class="card bg-light border-0 mb-3 p-3">
                <h6 class="text-muted mb-3 border-bottom pb-2">Fiyatlandırma Seçenekleri</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-bold">1. Fiyat (Zorunlu):</label>
                        <input type="text" name="Fiyat" class="form-control" required placeholder="0.00">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-bold">2. Fiyat (Opsiyonel):</label>
                        <input type="text" name="FiyatBuyuk" class="form-control" placeholder="Sadece pizzalar için...">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label small">1. Fiyat İsmi (Opsiyonel):</label>
                        <input type="text" name="FiyatTur" class="form-control form-control-sm" placeholder="Örn: Orta, Kutu">
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label small">2. Fiyat İsmi (Opsiyonel):</label>
                        <input type="text" name="FiyatBuyukTur" class="form-control form-control-sm" placeholder="Örn: Büyük, Şişe">
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Açıklama (İçindekiler):</label>
                <textarea name="Aciklama" class="form-control" rows="2" placeholder="Örn: Domates sos, mozzarella..."></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Ürün Resmi:</label>
                <input type="file" name="ResimDosyasi" class="form-control" accept="image/*">
            </div>

            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold">Kaydet</button>
        </form>

        <a href="/Urun/Index" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
    </div>

</body>
</html>