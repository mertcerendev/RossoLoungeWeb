@model List<RossoLoungeWeb.Models.Urun>
@*
    ÜRÜNLER
    ===============================================================
    Uçlar değişmedi: GET /Urun/Index?kategoriId= (filtre),
    POST /Urun/SiraGuncelle, POST /Urun/Sil/{id}.

    SIRALAMA KORUNDU. Sunucu yalnızca gönderilen kayıtların sıra
    numaralarını kendi aralarında dağıttığı için, kategori filtresi
    açıkken sıralamak listede görünmeyen ürünleri etkilemez.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Ürünler";
    ViewData["AltBaslik"] = "Menü kalemlerini yönetin ve sıralayın";
    ViewData["Aktif"] = "urunler";
    ViewData["AramaHedefi"] = "urun-tablosu";
    ViewData["AramaYerTutucu"] = "Ürün adı veya açıklamada ara";
}

@section Eylemler {
    <span class="y-rozet y-rozet--sonuk">
        Toplam <span data-tablo-sayac>@Model.Count</span>
    </span>
    <a class="y-dugme y-dugme--birincil" href="/Urun/Ekle">
        <i class="fas fa-plus" aria-hidden="true"></i> Yeni Ürün
    </a>
}

@* Kategori filtresi — method="get", antiforgery token GEREKMEZ *@
<form class="y-suzgec" method="get" action="/Urun/Index">
    <div class="y-suzgec__alan">
        <label class="y-suzgec__etiket" for="kategoriFiltre">Kategori</label>
        <select class="y-secim" name="kategoriId" id="kategoriFiltre" onchange="this.form.submit()">
            <option value="">Tümü</option>
            @if (ViewBag.Kategoriler != null)
            {
                foreach (var k in (SelectList)ViewBag.Kategoriler)
                {
                    if (ViewBag.SeciliKategoriId != null && k.Value == ViewBag.SeciliKategoriId.ToString())
                    {
                        <option value="@k.Value" selected>@k.Text</option>
                    }
                    else
                    {
                        <option value="@k.Value">@k.Text</option>
                    }
                }
            }
        </select>
    </div>

    <noscript>
        <button type="submit" class="y-dugme">Filtrele</button>
    </noscript>

    @if (ViewBag.SeciliKategoriId != null)
    {
        <a class="y-dugme" href="/Urun/Index">Filtreyi temizle</a>
    }
</form>

@if (Model.Count == 0)
{
    <div class="y-bos">
        <i class="y-bos__im fas fa-utensils" aria-hidden="true"></i>
        <h2 class="y-bos__baslik">Ürün bulunamadı</h2>
        <p class="y-bos__alt">Seçtiğiniz filtreye uyan ürün yok ya da menüye henüz ürün eklenmemiş.</p>
        <p class="y-bos__eylem">
            <a class="y-dugme y-dugme--birincil" href="/Urun/Ekle">Yeni ürün ekle</a>
        </p>
    </div>
}
else
{
    <p class="y-sira-durum" role="status" aria-live="polite"></p>
    <div hidden>@Html.AntiForgeryToken()</div>

    <div class="y-tablo-sarmal">
        <table class="y-tablo" id="urun-tablosu">
            <caption class="y-gizli">Menüdeki ürünler. Sıralama tutamakla sürüklenerek ya da ok tuşlarıyla değiştirilir.</caption>
            <thead>
                <tr>
                    <th scope="col">Sıra</th>
                    <th scope="col"><span class="y-gizli">Görsel</span></th>
                    <th scope="col">Ürün</th>
                    <th scope="col">Kategori</th>
                    <th scope="col">Fiyat</th>
                    <th scope="col" class="y-tablo__eylem"><span class="y-gizli">İşlemler</span></th>
                </tr>
            </thead>
            <tbody class="y-siralanabilir" data-sira-url="/Urun/SiraGuncelle">
                @foreach (var item in Model)
                {
                    <tr data-id="@item.Id">
                        <td>
                            <div class="y-sira">
                                <button type="button" class="y-sira__tut"
                                        aria-label="@item.Ad sırasını değiştir. Sürükleyin veya yukarı/aşağı ok tuşlarını kullanın."
                                        title="Sürükleyerek sırala">
                                    <i class="fas fa-grip-vertical" aria-hidden="true"></i>
                                </button>
                                <span class="y-sira__no y-sayi">@item.SiraNo</span>
                            </div>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(item.ResimUrl))
                            {
                                <span class="y-gorsel y-gorsel--bos" title="Görsel yok">
                                    <i class="fas fa-image" aria-hidden="true"></i>
                                    <span class="y-gizli">@item.Ad için görsel yok</span>
                                </span>
                            }
                            else
                            {
                                <img class="y-gorsel" src="@item.ResimUrl" alt="@item.Ad ürün görseli" loading="lazy">
                            }
                        </td>
                        <td>
                            <span class="y-tablo__ad">@item.Ad</span>
                            @if (!string.IsNullOrEmpty(item.Aciklama))
                            {
                                <span class="y-tablo__ikincil">
                                    @(item.Aciklama.Length > 48 ? item.Aciklama.Substring(0, 48) + "…" : item.Aciklama)
                                </span>
                            }
                        </td>
                        <td><span class="y-rozet y-rozet--sonuk">@item.Kategori?.Ad</span></td>
                        <td>
                            <span class="y-fiyat y-sayi">@item.Fiyat.ToString("N2") ₺</span>
                            @if (item.FiyatBuyuk != null)
                            {
                                <span class="y-tablo__ikincil y-sayi">Büyük: @item.FiyatBuyuk.Value.ToString("N2") ₺</span>
                            }
                        </td>
                        <td class="y-tablo__eylem">
                            <div class="y-eylemler">
                                <a class="y-hayalet" href="/Urun/Duzenle/@item.Id"
                                   title="Düzenle" aria-label="@item.Ad ürününü düzenle">
                                    <i class="fas fa-pen" aria-hidden="true"></i>
                                </a>

                                <form method="post" action="/Urun/Sil/@item.Id"
                                      onsubmit="return confirm('Bu ürünü silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="y-hayalet y-hayalet--tehlike"
                                            title="Sil" aria-label="@item.Ad ürününü sil">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Kutuphaneler {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
}
