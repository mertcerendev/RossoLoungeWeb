@model List<RossoLoungeWeb.Models.Rezervasyon>
@*
    REZERVASYONLAR
    ===============================================================
    Uçlar değişmedi: POST /Admin/Onayla/{id}, POST /Admin/Sil/{id}.
    WhatsApp bildirim metni de aynı mantıkla üretiliyor.

    Izgara kurgusu: bekleyen kayıtlar üstte vurgulanır (yöneticinin
    işi onlar), eylem ikonları satır hover'ında belirir.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Rezervasyonlar";
    ViewData["AltBaslik"] = "Siteden gelen masa talepleri";
    ViewData["Aktif"] = "rezervasyonlar";
    ViewData["AramaHedefi"] = "rezervasyon-tablosu";
    ViewData["AramaYerTutucu"] = "Ad, telefon veya notta ara";

    var bekleyen = Model.Count(x => !x.OnaylandiMi);
    int siraNo = 0;
}

@section Eylemler {
    <span class="y-rozet y-rozet--sonuk">
        Toplam <span data-tablo-sayac>@Model.Count</span>
    </span>
    @if (bekleyen > 0)
    {
        <span class="y-rozet y-rozet--uyari">@bekleyen bekliyor</span>
    }
}

@if (Model.Count == 0)
{
    <div class="y-bos">
        <i class="y-bos__im fas fa-calendar-xmark" aria-hidden="true"></i>
        <h2 class="y-bos__baslik">Henüz rezervasyon yok</h2>
        <p class="y-bos__alt">Site üzerinden gelen masa talepleri burada listelenir.</p>
    </div>
}
else
{
    <div class="y-tablo-sarmal">
        <table class="y-tablo" id="rezervasyon-tablosu">
            <caption class="y-gizli">Gelen rezervasyon talepleri</caption>
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Misafir</th>
                    <th scope="col">Telefon</th>
                    <th scope="col">Tarih / Saat</th>
                    <th scope="col">Kişi</th>
                    <th scope="col">Not</th>
                    <th scope="col">Durum</th>
                    <th scope="col" class="y-tablo__eylem"><span class="y-gizli">İşlemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    siraNo++;

                    // WhatsApp bildirim metni — onaylı/bekliyor durumuna göre değişir.
                    string mesaj = item.OnaylandiMi
                        ? $"Sayın {item.AdSoyad}, {item.Tarih:dd.MM.yyyy HH:mm} tarihli {item.KisiSayisi} kişilik rezervasyonunuz ONAYLANMIŞTIR. Sizi ağırlamaktan mutluluk duyarız. - Rosso Lounge Bistro"
                        : $"Sayın {item.AdSoyad}, {item.Tarih:dd.MM.yyyy HH:mm} tarihli rezervasyon talebiniz alınmıştır. Müsaitlik durumuna göre size en kısa sürede dönüş yapılacaktır. - Rosso Lounge Bistro";
                    string wpLink = $"https://wa.me/90{item.Telefon}?text={System.Net.WebUtility.UrlEncode(mesaj)}";

                    <tr class="@(item.OnaylandiMi ? null : "y-satir--dikkat")">
                        <td class="y-sayi">@siraNo</td>
                        <td class="y-tablo__ad">@item.AdSoyad</td>
                        <td><a class="y-bag y-sayi" href="tel:@item.Telefon">@item.Telefon</a></td>
                        <td>
                            <span class="y-sayi">@item.Tarih.ToString("dd.MM.yyyy")</span>
                            <span class="y-tablo__ikincil y-sayi">@item.Tarih.ToString("HH:mm")</span>
                        </td>
                        <td class="y-sayi">@item.KisiSayisi</td>
                        <td class="y-tablo__not">@item.Not</td>
                        <td>
                            @if (item.OnaylandiMi)
                            {
                                <span class="y-rozet y-rozet--basari">Onaylı</span>
                            }
                            else
                            {
                                <span class="y-rozet y-rozet--uyari">Bekliyor</span>
                            }
                        </td>
                        <td class="y-tablo__eylem">
                            <div class="y-eylemler">
                                @if (!item.OnaylandiMi)
                                {
                                    <form method="post" action="/Admin/Onayla/@item.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="y-hayalet"
                                                title="Onayla"
                                                aria-label="@item.AdSoyad adına rezervasyonu onayla">
                                            <i class="fas fa-check" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }

                                <a class="y-hayalet" href="@wpLink" target="_blank" rel="noopener"
                                   title="WhatsApp ile bildir"
                                   aria-label="@item.AdSoyad kişisine WhatsApp ile bildir">
                                    <i class="fab fa-whatsapp" aria-hidden="true"></i>
                                </a>

                                <form method="post" action="/Admin/Sil/@item.Id"
                                      onsubmit="return confirm('Bu rezervasyonu silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="y-hayalet y-hayalet--tehlike"
                                            title="Sil"
                                            aria-label="@item.AdSoyad adına rezervasyonu sil">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
