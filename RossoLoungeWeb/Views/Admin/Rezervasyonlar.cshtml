@model List<RossoLoungeWeb.Models.Rezervasyon>

@{
    Layout = null;
    int siraNo = 0;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetici Paneli | Rosso Lounge</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Masaüstü Sidebar */
        .sidebar {
            height: 100vh;
            background: #1a1a1a;
            color: white;
            padding: 20px;
            position: fixed;
            width: 250px;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .content {
            margin-left: 250px;
            padding: 30px;
            transition: all 0.3s;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 40px;
            display: block;
            color: white;
            text-decoration: none;
        }

            .logo span {
                color: #e74c3c;
            }

        .menu-item {
            display: block;
            padding: 12px 15px;
            color: #bbb;
            text-decoration: none;
            margin-bottom: 5px;
            border-radius: 8px;
            transition: 0.3s;
        }

            .menu-item:hover, .menu-item.active {
                background: #e74c3c;
                color: white;
                transform: translateX(5px);
            }

        .card {
            border: none;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            border-radius: 10px;
        }

        /* Mobil Uyum */
        @@media (max-width: 768px) {
            .sidebar

        {
            width: 100%;
            height: auto;
            position: relative;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .menu-item {
            width: 100%;
            text-align: center;
            margin-bottom: 5px;
        }

            .menu-item:hover {
                transform: none;
            }

        .content {
            margin-left: 0;
            padding: 15px;
        }

        .table-responsive {
            overflow-x: auto;
        }

        }
    </style>
</head>
<body>

    <div class="sidebar">
        <a href="#" class="logo">ROSSO <span>PANEL</span></a>
        <a href="/Admin/Index" class="menu-item"><i class="fas fa-home me-2"></i> Özet</a>
        <a href="/Admin/Rezervasyonlar" class="menu-item active"><i class="fas fa-calendar-check me-2"></i> Rezervasyonlar</a>
        <a href="/Kategori/Index" class="menu-item"><i class="fas fa-list me-2"></i> Kategoriler</a>
        <a href="/Urun/Index" class="menu-item"><i class="fas fa-utensils me-2"></i> Ürünler</a>
        <a href="/Admin/Yorumlar" class="menu-item"><i class="fas fa-comments me-2"></i> Yorumlar</a>
        <a href="/Admin/MailAyarlari" class="menu-item"><i class="fas fa-envelope me-2"></i> Mail Ayarları</a>
        <a href="/Admin/Profil" class="menu-item"><i class="fas fa-user-cog me-2"></i> Ayarlar</a>
        <a href="/" target="_blank" class="menu-item"><i class="fas fa-globe me-2"></i> Siteye Git</a>
        <a href="/Admin/CikisYap" class="menu-item bg-dark mt-3"><i class="fas fa-sign-out-alt me-2"></i> Çıkış Yap</a>
    </div>

    <div class="content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="m-0">Gelen Rezervasyonlar</h2>
            <span class="badge bg-primary p-2">Toplam: @Model.Count</span>
        </div>

        <div class="card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Müşteri</th>
                            <th>Telefon</th>
                            <th>Tarih/Saat</th>
                            <th>Kişi</th>
                            <th style="min-width: 150px;">Not</th>
                            <th>Durum</th>
                            <th style="min-width: 140px;">İşlem & Bildir</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            // Sayacı artır
                            siraNo++;

                            // --- WhatsApp Mesajlarını Hazırla (DETAYLI) ---
                            string wpLink = "";
                            if (item.OnaylandiMi)
                            {
                                // Onaylandığında gidecek mesaj:
                                string mesaj = $"Sayın {item.AdSoyad}, {item.Tarih.ToString("dd.MM.yyyy HH:mm")} tarihli {item.KisiSayisi} kişilik rezervasyonunuz ONAYLANMIŞTIR. Sizi ağırlamaktan mutluluk duyarız. - Rosso Lounge Bistro";

                                // URL Encode: Boşlukları ve Türkçe karakterleri link formatına çevirir
                                wpLink = $"https://wa.me/90{item.Telefon}?text={System.Net.WebUtility.UrlEncode(mesaj)}";
                            }
                            else
                            {
                                // Beklemedeyken gidecek mesaj:
                                string mesaj = $"Sayın {item.AdSoyad}, {item.Tarih.ToString("dd.MM.yyyy HH:mm")} tarihli rezervasyon talebiniz alınmıştır. Müsaitlik durumuna göre size en kısa sürede dönüş yapılacaktır. - Rosso Lounge Bistro";
                                wpLink = $"https://wa.me/90{item.Telefon}?text={System.Net.WebUtility.UrlEncode(mesaj)}";
                            }

                            <tr class="@(item.OnaylandiMi ? "table-success" : "")">

                                <td><b>@siraNo</b></td>

                                <td>@item.AdSoyad</td>
                                <td><a href="tel:@item.Telefon" class="text-decoration-none text-dark">@item.Telefon</a></td>
                                <td>
                                    <span class="badge bg-warning text-dark">@item.Tarih.ToString("dd.MM.yyyy")</span>
                                    <small class="d-block text-muted">@item.Tarih.ToString("HH:mm")</small>
                                </td>
                                <td class="text-center">@item.KisiSayisi</td>
                                <td><small>@item.Not</small></td>

                                <td>
                                    @if (item.OnaylandiMi)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check"></i> Onaylı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Bekliyor</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-1">
                                        @if (!item.OnaylandiMi)
                                        {
                                            <form action="/Admin/Onayla/@item.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-success" title="Onayla">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }

                                        <form action="/Admin/Sil/@item.Id" method="post" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Sil">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>

                                        <a href="@wpLink" target="_blank" class="btn btn-sm btn-success" title="WhatsApp ile Bildir" style="background-color: #25D366; border-color: #25D366;">
                                            <i class="fab fa-whatsapp"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Count == 0)
            {
                <div class="p-5 text-center text-muted">
                    <i class="fas fa-inbox fa-3x mb-3"></i>
                    <p>Henüz hiç rezervasyon yok.</p>
                </div>
            }
        </div>
    </div>

</body>
</html>