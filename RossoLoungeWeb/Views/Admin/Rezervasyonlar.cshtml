@model List<RossoLoungeWeb.Models.Rezervasyon>

@{
    Layout = null;
    ViewBag.AktifMenu = "rezervasyonlar";
    int siraNo = 0;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rezervasyonlar | Rosso Lounge</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true">
</head>
<body class="panel">
    <a href="#icerik" class="icerige-atla">İçeriğe atla</a>

    @await Html.PartialAsync("~/Views/Admin/_YanMenu.cshtml")

    <main class="content" id="icerik">
        @await Html.PartialAsync("~/Views/Admin/_Bildirim.cshtml")

        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
            <h2 class="m-0">Gelen Rezervasyonlar</h2>
            <span class="rs-rozet rs-rozet-bilgi">Toplam: @Model.Count</span>
        </div>

        <div class="custom-card">
            @if (Model.Count == 0)
            {
                <div class="rs-bos-durum">
                    <i class="fas fa-calendar-xmark" aria-hidden="true"></i>
                    <h3>Henüz rezervasyon yok</h3>
                    <p>Site üzerinden gelen rezervasyon talepleri burada listelenir.</p>
                    <a href="/" target="_blank" rel="noopener" class="rs-btn rs-btn-ikincil rs-btn-sm">Siteyi Görüntüle</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom m-0 align-middle">
                        <caption class="gorsel-gizli">Gelen rezervasyon talepleri listesi</caption>
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Müşteri</th>
                                <th scope="col">Telefon</th>
                                <th scope="col">Tarih / Saat</th>
                                <th scope="col">Kişi</th>
                                <th scope="col" style="min-width: 160px;">Not</th>
                                <th scope="col">Durum</th>
                                <th scope="col" style="min-width: 150px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                siraNo++;

                                // WhatsApp bildirim metni — onaylı/bekliyor durumuna göre değişir.
                                string mesaj = item.OnaylandiMi
                                    ? $"Sayın {item.AdSoyad}, {item.Tarih:dd.MM.yyyy HH:mm} tarihli {item.KisiSayisi} kişilik rezervasyonunuz ONAYLANMIŞTIR. Sizi ağırlamaktan mutluluk duyarız. - Rosso Lounge Bistro"
                                    : $"Sayın {item.AdSoyad}, {item.Tarih:dd.MM.yyyy HH:mm} tarihli rezervasyon talebiniz alınmıştır. Müsaitlik durumuna göre size en kısa sürede dönüş yapılacaktır. - Rosso Lounge Bistro";
                                string wpLink = $"https://wa.me/90{item.Telefon}?text={System.Net.WebUtility.UrlEncode(mesaj)}";

                                <tr class="@(item.OnaylandiMi ? "" : "unread")">
                                    <td><b>@siraNo</b></td>
                                    <td>@item.AdSoyad</td>
                                    <td><a href="tel:@item.Telefon" class="text-decoration-none">@item.Telefon</a></td>
                                    <td>
                                        <span class="rs-rozet">@item.Tarih.ToString("dd.MM.yyyy")</span>
                                        <small class="d-block rs-soluk">@item.Tarih.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-center">@item.KisiSayisi</td>
                                    <td><small>@item.Not</small></td>
                                    <td>
                                        @if (item.OnaylandiMi)
                                        {
                                            <span class="rs-rozet rs-rozet-basari"><i class="fas fa-check" aria-hidden="true"></i> Onaylı</span>
                                        }
                                        else
                                        {
                                            <span class="rs-rozet rs-rozet-uyari">Bekliyor</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            @if (!item.OnaylandiMi)
                                            {
                                                <form action="/Admin/Onayla/@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-action bg-success text-white"
                                                            aria-label="@item.AdSoyad adına rezervasyonu onayla"
                                                            title="Onayla">
                                                        <i class="fas fa-check" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }

                                            <form action="/Admin/Sil/@item.Id" method="post"
                                                  onsubmit="return confirm('Bu rezervasyonu silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action btn-delete"
                                                        aria-label="@item.AdSoyad adına rezervasyonu sil"
                                                        title="Sil">
                                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                                </button>
                                            </form>

                                            <a href="@wpLink" target="_blank" rel="noopener"
                                               class="btn-action bg-success text-white"
                                               aria-label="@item.AdSoyad kişisine WhatsApp ile bildir"
                                               title="WhatsApp ile Bildir">
                                                <i class="fab fa-whatsapp" aria-hidden="true"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>

    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/panel.js" asp-append-version="true"></script>
</body>
</html>
