@*
    Panel yan menüsü — Admin, Kategori ve Ürün görünümlerinin ortak sidebar'ı.
    Çağrı: @await Html.PartialAsync("~/Views/Admin/_YanMenu.cshtml")
    Aktif öğe: ViewBag.AktifMenu = "ozet" | "rezervasyonlar" | "kategoriler" |
               "urunler" | "yorumlar" | "mesajlar" | "mail" | "profil"
*@
@{
    var aktif = ViewBag.AktifMenu as string ?? "";
}
<nav class="sidebar" aria-label="Panel menüsü">
    <a href="/Admin/Index" class="logo">ROSSO <span>PANEL</span></a>

    <a href="/Admin/Index" class="menu-item @(aktif == "ozet" ? "active" : null)" aria-current="@(aktif == "ozet" ? "page" : null)">
        <i class="fas fa-home" aria-hidden="true"></i> Özet
    </a>
    <a href="/Admin/Rezervasyonlar" class="menu-item @(aktif == "rezervasyonlar" ? "active" : null)" aria-current="@(aktif == "rezervasyonlar" ? "page" : null)">
        <i class="fas fa-calendar-check" aria-hidden="true"></i> Rezervasyonlar
    </a>
    <a href="/Kategori/Index" class="menu-item @(aktif == "kategoriler" ? "active" : null)" aria-current="@(aktif == "kategoriler" ? "page" : null)">
        <i class="fas fa-list" aria-hidden="true"></i> Kategoriler
    </a>
    <a href="/Urun/Index" class="menu-item @(aktif == "urunler" ? "active" : null)" aria-current="@(aktif == "urunler" ? "page" : null)">
        <i class="fas fa-utensils" aria-hidden="true"></i> Ürünler
    </a>
    <a href="/Admin/Yorumlar" class="menu-item @(aktif == "yorumlar" ? "active" : null)" aria-current="@(aktif == "yorumlar" ? "page" : null)">
        <i class="fas fa-comments" aria-hidden="true"></i> Yorumlar
    </a>
    <a href="/Admin/Mesajlar" class="menu-item @(aktif == "mesajlar" ? "active" : null)" aria-current="@(aktif == "mesajlar" ? "page" : null)">
        <i class="fas fa-comment-dots" aria-hidden="true"></i> Mesajlar
    </a>
    <a href="/Admin/MailAyarlari" class="menu-item @(aktif == "mail" ? "active" : null)" aria-current="@(aktif == "mail" ? "page" : null)">
        <i class="fas fa-envelope" aria-hidden="true"></i> Mail Ayarları
    </a>
    <a href="/Admin/Profil" class="menu-item @(aktif == "profil" ? "active" : null)" aria-current="@(aktif == "profil" ? "page" : null)">
        <i class="fas fa-user-cog" aria-hidden="true"></i> Ayarlar
    </a>
    <a href="/" target="_blank" rel="noopener" class="menu-item">
        <i class="fas fa-globe" aria-hidden="true"></i> Siteye Git
    </a>
    <a href="/Admin/CikisYap" class="menu-item bg-dark mt-3">
        <i class="fas fa-sign-out-alt" aria-hidden="true"></i> Çıkış Yap
    </a>
</nav>
