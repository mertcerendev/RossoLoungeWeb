@model List<RossoLoungeWeb.Models.Yorum>
@{
    Layout = null;
    ViewBag.AktifMenu = "yorumlar";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yorum Yönetimi | Rosso Lounge</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true">
</head>
<body class="panel">
    <a href="#icerik" class="icerige-atla">İçeriğe atla</a>

    @await Html.PartialAsync("~/Views/Admin/_YanMenu.cshtml")

    <main class="content" id="icerik">
        @await Html.PartialAsync("~/Views/Admin/_Bildirim.cshtml")

        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
            <h2 class="m-0">Müşteri Yorumları</h2>
            <span class="rs-rozet rs-rozet-bilgi">Toplam: @Model.Count</span>
        </div>

        <div class="custom-card">
            @if (Model.Count == 0)
            {
                <div class="rs-bos-durum">
                    <i class="fas fa-comments" aria-hidden="true"></i>
                    <h3>Henüz yorum yok</h3>
                    <p>Ziyaretçilerin siteden bıraktığı yorumlar burada listelenir; onayladıklarınız sitede yayınlanır.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom m-0">
                        <caption class="gorsel-gizli">Müşteri yorumları listesi</caption>
                        <thead>
                            <tr>
                                <th scope="col">Müşteri</th>
                                <th scope="col" style="min-width: 220px;">Mesaj Özeti</th>
                                <th scope="col">Puan</th>
                                <th scope="col">Tarih</th>
                                <th scope="col">Durum</th>
                                <th scope="col" style="min-width: 140px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.OnaylandiMi ? "" : "unread")">
                                    <td class="fw-bold">@item.AdSoyad</td>
                                    <td>
                                        <small>@(item.Mesaj.Length > 60 ? item.Mesaj.Substring(0, 60) + "..." : item.Mesaj)</small>
                                    </td>
                                    <td>
                                        <span class="gorsel-gizli">5 üzerinden @item.Puan puan</span>
                                        <span class="text-warning small" aria-hidden="true">
                                            @for (int i = 0; i < item.Puan; i++)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                        </span>
                                    </td>
                                    <td>@item.Tarih.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (item.OnaylandiMi)
                                        {
                                            <span class="rs-rozet rs-rozet-basari">Yayında</span>
                                        }
                                        else
                                        {
                                            <span class="rs-rozet rs-rozet-uyari">Onay Bekliyor</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn-action btn-edit yorum-oku"
                                                    data-ad="@item.AdSoyad" data-mesaj="@item.Mesaj"
                                                    aria-label="@item.AdSoyad adlı ziyaretçinin yorumunun tamamını oku"
                                                    title="Tamamını Oku">
                                                <i class="fas fa-eye" aria-hidden="true"></i>
                                            </button>

                                            @if (!item.OnaylandiMi)
                                            {
                                                <form action="/Admin/YorumOnayla/@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-action bg-success text-white"
                                                            aria-label="@item.AdSoyad adlı ziyaretçinin yorumunu yayınla"
                                                            title="Yayınla">
                                                        <i class="fas fa-check" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }

                                            <form action="/Admin/YorumSil/@item.Id" method="post"
                                                  onsubmit="return confirm('Bu yorumu silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action btn-delete"
                                                        aria-label="@item.AdSoyad adlı ziyaretçinin yorumunu sil"
                                                        title="Sil">
                                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>

    <div class="modal fade" id="readModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="modalTitle">Yorum Detayı</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p id="modalMessage" class="mesaj-govde m-0"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="rs-btn rs-btn-hayalet rs-btn-sm" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/panel.js" asp-append-version="true"></script>
</body>
</html>
