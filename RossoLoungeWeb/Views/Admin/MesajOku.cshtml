@model RossoLoungeWeb.Models.Iletisim
@*
    MESAJ DETAYI
    ===============================================================
    Uçlar: POST /Admin/MesajOkunmadi/{id}, POST /Admin/MesajSil/{id}.
    Sayfanın açılması mesajı okundu olarak işaretliyor (controller'da).

    DÖNÜŞ ADRESİ: gelen kutusundan hangi süzgeç/sayfa ile gelindiyse
    oraya dönülüyor. Aksi hâlde 3. sayfadaki bir mesajı okuyan kişi
    listenin başına düşüyor ve kaldığı yeri kaybediyordu.
    Adres controller'da Url.IsLocalUrl'den geçiyor.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Mesaj";
    ViewData["AltBaslik"] = Model.AdSoyad;
    ViewData["Aktif"] = "mesajlar";

    var donus = ViewBag.Donus as string ?? Url.Action("Mesajlar");
}

@section Eylemler {
    <a class="y-dugme" href="@donus">
        <i class="fas fa-arrow-left" aria-hidden="true"></i> Gelen kutusu
    </a>
}

<article class="y-okuma">
    <header class="y-okuma__bas">
        <div>
            <h2 class="y-kart__baslik">@Model.AdSoyad</h2>
            <p class="y-tablo__ikincil y-sayi">@Model.Tarih.ToString("dd.MM.yyyy HH:mm")</p>
        </div>
        <span class="y-rozet y-rozet--sonuk">@(Model.OkunduMu ? "Okundu" : "Yeni")</span>
    </header>

    <dl class="y-liste">
        <div class="y-liste__satir">
            <dt>E-posta</dt>
            <dd><a class="y-bag" href="mailto:@Model.Email">@Model.Email</a></dd>
        </div>
        <div class="y-liste__satir">
            <dt>Telefon</dt>
            <dd>
                @if (string.IsNullOrEmpty(Model.Telefon))
                {
                    <span class="y-tablo__ikincil">Belirtilmemiş</span>
                }
                else
                {
                    <a class="y-bag y-sayi" href="tel:@Model.Telefon">@Model.Telefon</a>
                }
            </dd>
        </div>
    </dl>

    <p class="y-okuma__govde">@Model.Mesaj</p>

    <div class="y-okuma__ayak">
        <a class="y-dugme y-dugme--birincil" href="mailto:@Model.Email?subject=Rosso Lounge Bistro">
            <i class="fas fa-reply" aria-hidden="true"></i> Yanıtla
        </a>

        @* Sayfayı açmak mesajı okundu yaptı. İş yarıda kaldıysa geri
           alınabilsin: gelen kutusunda tekrar "yeni" olarak görünür. *@
        <form method="post" action="/Admin/MesajOkunmadi/@Model.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="donus" value="@donus">
            <button type="submit" class="y-dugme">
                <i class="fas fa-rotate-left" aria-hidden="true"></i> Okunmadı işaretle
            </button>
        </form>

        <form method="post" action="/Admin/MesajSil/@Model.Id"
              onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="donus" value="@donus">
            <button type="submit" class="y-dugme y-dugme--tehlike">
                <i class="fas fa-trash-can" aria-hidden="true"></i> Sil
            </button>
        </form>
    </div>
</article>
