@model RossoLoungeWeb.Models.Yonetici
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetici Girişi | Rosso Lounge</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true">
</head>
<body class="giris-zemin giris-fotograf">

    <main class="login-card">
        <h2>Yönetici Paneli</h2>

        @if (ViewBag.Hata != null)
        {
            <div class="rs-uyari rs-uyari-hata" role="alert">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                <div>@ViewBag.Hata</div>
            </div>
        }

        <form action="/Admin/LoginYap" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <label for="kullaniciAdi" class="gorsel-gizli">Kullanıcı adı</label>
            <div class="custom-input-box">
                <div class="icon-left"><i class="fas fa-user" aria-hidden="true"></i></div>
                <input type="text" id="kullaniciAdi" name="KullaniciAdi" class="form-input"
                       placeholder="Kullanıcı Adı" required autocomplete="username">
            </div>

            <label for="loginPassword" class="gorsel-gizli">Şifre</label>
            <div class="custom-input-box">
                <div class="icon-left"><i class="fas fa-lock" aria-hidden="true"></i></div>
                <input type="password" id="loginPassword" name="Sifre" class="form-input"
                       placeholder="Şifre" required autocomplete="current-password">

                <div class="toggle-password" id="loginToggle" role="button" tabindex="0"
                     aria-label="Şifreyi göster" aria-pressed="false">
                    <i class="fas fa-eye-slash" id="loginEyeIcon" aria-hidden="true"></i>
                </div>
            </div>

            <p class="text-end">
                <a href="/Admin/SifremiUnuttum" class="rs-vurgu">Şifremi Unuttum?</a>
            </p>

            <button type="submit" class="btn-login">Giriş Yap</button>
        </form>

        <a href="/" class="back-home">← Siteye Geri Dön</a>
    </main>

    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/panel.js" asp-append-version="true"></script>
</body>
</html>
