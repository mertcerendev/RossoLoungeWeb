@*
    YÖNETİCİ GİRİŞİ
    ===============================================================
    Panelin tek kayıtsız (anonim) ekranı. Kendi kabuğunu taşıyor —
    kenar çubuğu ve üst bar burada anlamsız olduğu için
    _AdminLayout kullanılmıyor.

    ⚠️ KİMLİK DOĞRULAMA — MEVCUT DURUM
    Bu proje ASP.NET Core Identity KULLANMIYOR. Kimlik doğrulama
    `Yonetici` tablosu + BCrypt + oturum (session) üzerinden
    yürüyor; hedef `AdminController.LoginYap(string KullaniciAdi,
    string Sifre)`.

    Identity'ye geçilirse burada değişecek TEK yer aşağıdaki form:
      action → /Identity/Account/Login
      name'ler → Input.Email, Input.Password, Input.RememberMe
    Görsel yapının (kart, yüzen etiket, doğrulama özeti) hiçbiri
    değişmez. Kayıt (Register) ekranı bilinçli olarak YOK: panelde
    kendi kendine hesap açılması bir güvenlik açığı olur, yönetici
    hesapları Ayarlar ekranından açılır.
*@
@{
    Layout = null;
    ViewData["Baslik"] = "Yönetici Girişi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Yönetici Girişi · Rosso Panel</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/yonetim.css" asp-append-version="true">
</head>
<body class="yonetim">

    <main class="y-giris">
        <div class="y-giris__kart">
            <span class="y-giris__marka">Rosso <span>Panel</span></span>

            <h1 class="y-giris__baslik">Yönetici Girişi</h1>
            <p class="y-giris__alt">Devam etmek için hesabınızla oturum açın.</p>

            @* Doğrulama özeti — ince kırmızı çerçeve.
               Sunucu ayrıntı vermiyor ("kullanıcı adı yanlış" vs.
               "şifre yanlış" ayrımı, geçerli kullanıcı adlarını
               sızdırır); mesaj bilinçli olarak tek ve geneldir. *@
            @if (ViewBag.Hata != null)
            {
                <div class="y-ozet y-ozet--sayfa" role="alert">
                    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                    <div>@ViewBag.Hata</div>
                </div>
            }

            <form class="y-giris__form" method="post" action="/Admin/LoginYap" autocomplete="on">
                @Html.AntiForgeryToken()

                <div class="y-alan">
                    <input class="y-alan__girdi" type="text" id="kullaniciAdi" name="KullaniciAdi"
                           placeholder=" " autocomplete="username" maxlength="50"
                           required autofocus>
                    <label class="y-alan__etiket" for="kullaniciAdi">Kullanıcı adı</label>
                </div>

                <div class="y-alan">
                    <input class="y-alan__girdi" type="password" id="sifre" name="Sifre"
                           placeholder=" " autocomplete="current-password" maxlength="100" required>
                    <label class="y-alan__etiket" for="sifre">Şifre</label>

                    <button type="button" class="y-alan__eylem" data-sifre-gor
                            aria-controls="sifre" aria-label="Şifreyi göster">
                        <i class="fas fa-eye" aria-hidden="true"></i>
                    </button>
                </div>

                <button type="submit" class="y-dugme y-dugme--birincil y-dugme--tam">
                    Oturum Aç
                </button>
            </form>

            <div class="y-giris__ayak">
                <a href="/Admin/SifremiUnuttum">Şifremi unuttum</a>
                <a href="/" target="_blank" rel="noopener">Siteye dön</a>
            </div>
        </div>
    </main>

    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/yonetim.js" asp-append-version="true"></script>
</body>
</html>
