@model RossoLoungeWeb.Models.SistemAyarlari
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Mail Ayarları</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Aynı Stil Bloğu (Kopyalanabilir) */
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            height: 100vh;
            background: #1a1a1a;
            color: white;
            padding: 20px;
            position: fixed;
            width: 250px;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .content {
            margin-left: 250px;
            padding: 30px;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 40px;
            display: block;
            color: white;
            text-decoration: none;
        }

            .logo span {
                color: #e74c3c;
            }

        .menu-item {
            display: block;
            padding: 12px 15px;
            color: #bbb;
            text-decoration: none;
            margin-bottom: 5px;
            border-radius: 8px;
            transition: 0.3s;
        }

            .menu-item:hover, .menu-item.active {
                background: #e74c3c;
                color: white;
            }
        @@media (max-width: 768px) {
            .sidebar

        {
            width: 100%;
            height: auto;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .content {
            margin-left: 0;
            padding: 15px;
        }

        .menu-item {
            width: 100%;
            text-align: center;
        }

        }
    </style>
</head>
<body>
    <div class="sidebar">
        <a href="#" class="logo">ROSSO <span>PANEL</span></a>
        <a href="/Admin/Index" class="menu-item"><i class="fas fa-home me-2"></i> Özet</a>
        <a href="/Admin/Rezervasyonlar" class="menu-item"><i class="fas fa-calendar-check me-2"></i> Rezervasyonlar</a>
        <a href="/Kategori/Index" class="menu-item"><i class="fas fa-list me-2"></i> Kategoriler</a>
        <a href="/Urun/Index" class="menu-item"><i class="fas fa-utensils me-2"></i> Ürünler</a>
        <a href="/Admin/Yorumlar" class="menu-item"><i class="fas fa-comments me-2"></i> Yorumlar</a>
        <a href="/Admin/MailAyarlari" class="menu-item active"><i class="fas fa-envelope me-2"></i> Mail Ayarları</a>
        <a href="/Admin/Profil" class="menu-item"><i class="fas fa-user-cog me-2"></i> Ayarlar</a>
        <a href="/" target="_blank" class="menu-item"><i class="fas fa-globe me-2"></i> Siteye Git</a>
        <a href="/Admin/CikisYap" class="menu-item bg-dark mt-3"><i class="fas fa-sign-out-alt me-2"></i> Çıkış Yap</a>
    </div>

    <div class="content">
        <div class="card shadow mx-auto p-4" style="max-width: 600px;">
            <h4>Sistem Mail Ayarları</h4>
            @if (ViewBag.Mesaj != null)
            {
                <div class="alert alert-success">@ViewBag.Mesaj</div>
            }
            <form action="/Admin/MailAyarlariGuncelle" method="post">
                <div class="mb-3"><label>Gmail Adresi:</label><input type="email" name="GonderenMail" value="@Model.GonderenMail" class="form-control" required /></div>
                <div class="mb-3"><label>Uygulama Şifresi:</label><input type="text" name="GonderenSifre" value="@Model.GonderenSifre" class="form-control" required /></div>
                <div class="row">
                    <div class="col-md-8 mb-3"><label>SMTP Sunucu:</label><input type="text" name="SmtpSunucu" value="@Model.SmtpSunucu" class="form-control" required /></div>
                    <div class="col-md-4 mb-3"><label>Port:</label><input type="number" name="SmtpPort" value="@Model.SmtpPort" class="form-control" required /></div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Ayarları Kaydet</button>
            </form>
        </div>
    </div>
</body>
</html>