@model RossoLoungeWeb.Models.SistemAyarlari
@*
    AYARLAR — SMTP
    ===============================================================
    Uç değişmedi: POST /Admin/MailAyarlariGuncelle.

    NOT: GonderenSifre veritabanında düz metin duruyor (DEVAM.md'de
    açık madde). Alan tipi password, ekranda gizli — ama bu yalnızca
    omuz üstünden okumayı engelliyor, saklama sorununu çözmüyor.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Mail Ayarları";
    ViewData["AltBaslik"] = "Şifre sıfırlama ve bildirim e-postaları bu hesaptan gönderilir";
    ViewData["Aktif"] = "ayarlar";
}

@section Eylemler {
    <a class="y-dugme" href="/Admin/Profil">
        <i class="fas fa-arrow-left" aria-hidden="true"></i> Hesap ayarları
    </a>
}

@if (ViewBag.Mesaj != null)
{
    <div class="y-ozet y-ozet--basari y-ozet--sayfa" role="status">
        <i class="fas fa-circle-check" aria-hidden="true"></i>
        <div>@ViewBag.Mesaj</div>
    </div>
}
@if (ViewBag.Hata != null)
{
    <div class="y-ozet y-ozet--sayfa" role="alert">
        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
        <div>@ViewBag.Hata</div>
    </div>
}
@await Html.PartialAsync("_YonetimDogrulama")

<form class="y-form" method="post" action="/Admin/MailAyarlariGuncelle">
    @Html.AntiForgeryToken()

    <div class="y-form__alan">
        <label class="y-form__etiket" for="gonderenMail">
            Gönderen e-posta <span class="y-zorunlu" aria-hidden="true">*</span>
        </label>
        <input class="y-girdi" type="email" id="gonderenMail" name="GonderenMail"
               value="@Model.GonderenMail" autocomplete="email" required>
    </div>

    <div class="y-form__alan">
        <label class="y-form__etiket" for="gonderenSifre">
            Uygulama şifresi <span class="y-zorunlu" aria-hidden="true">*</span>
        </label>

        <div class="y-alan">
            <input class="y-girdi" type="password" id="gonderenSifre" name="GonderenSifre"
                   value="@Model.GonderenSifre" autocomplete="off" required
                   aria-describedby="sifre-yardim">
            <button type="button" class="y-alan__eylem" data-sifre-gor
                    aria-controls="gonderenSifre" aria-label="Şifreyi göster">
                <i class="fas fa-eye" aria-hidden="true"></i>
            </button>
        </div>

        <p class="y-form__yardim" id="sifre-yardim">
            Gmail için normal hesap şifresi değil, 16 haneli “uygulama şifresi” girilmelidir.
        </p>
    </div>

    <div class="y-form__izgara">
        <div class="y-form__alan">
            <label class="y-form__etiket" for="smtpSunucu">
                SMTP sunucu <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            <input class="y-girdi" type="text" id="smtpSunucu" name="SmtpSunucu"
                   value="@Model.SmtpSunucu" required>
        </div>

        <div class="y-form__alan">
            <label class="y-form__etiket" for="smtpPort">
                Port <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            <input class="y-girdi y-girdi--sayi" type="number" id="smtpPort" name="SmtpPort"
                   value="@Model.SmtpPort" min="1" max="65535" required>
        </div>
    </div>

    <div class="y-form__ayak">
        <button type="submit" class="y-dugme y-dugme--birincil">Ayarları kaydet</button>
    </div>
</form>
