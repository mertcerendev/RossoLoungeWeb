@*
    ÖZET (DASHBOARD)
    ===============================================================
    Yeni panel iskeletinin ilk kullanıcısı. Veri kaynağı değişmedi:
    AdminController.Index'in doldurduğu ViewBag'ler aynen kullanılıyor.

    Ekranın kurgusu "yöneticinin bekleyen işi" üzerine: en üstte
    aksiyon gerektiren sayılar, altında son 7 günün rezervasyon
    dağılımı ve hızlı geçişler.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Özet";
    ViewData["AltBaslik"] = "Bekleyen işler ve son hareketler";
    ViewData["Aktif"] = "ozet";
    ViewData["BekleyenYorum"] = (int?)ViewBag.OnayBekleyenYorum;
    ViewData["OkunmamisMesaj"] = (int?)ViewBag.OkunmamisMesaj;
    ViewData["Bildirim"] = (int?)ViewBag.OkunmamisMesaj;

    var gunler = ViewBag.GrafikGunler as List<string> ?? new List<string>();
    var sayilar = ViewBag.GrafikSayilar as List<int> ?? new List<int>();
    var enYuksek = sayilar.Count > 0 && sayilar.Max() > 0 ? sayilar.Max() : 1;
}

@section Eylemler {
    <a class="y-dugme" href="/Admin/Rezervasyonlar">
        <i class="fas fa-calendar-check" aria-hidden="true"></i> Rezervasyonlar
    </a>
    <a class="y-dugme y-dugme--birincil" href="/Urun/Ekle">
        <i class="fas fa-plus" aria-hidden="true"></i> Ürün Ekle
    </a>
}

@* --- Bekleyen işler --- *@
<section class="y-izgara-kart" aria-label="Bekleyen işler">
    <article class="y-olcut">
        <p class="y-olcut__etiket">Bugünkü rezervasyon</p>
        <p class="y-olcut__deger">@ViewBag.BugunkuRezervasyon</p>
        <p class="y-olcut__alt">Toplam @ViewBag.ToplamRezervasyon kayıt</p>
    </article>

    <article class="y-olcut">
        <p class="y-olcut__etiket">Onay bekleyen</p>
        <p class="y-olcut__deger">@ViewBag.BekleyenRezervasyon</p>
        <p class="y-olcut__alt">
            @if (ViewBag.BekleyenRezervasyon > 0)
            {
                <span class="y-rozet y-rozet--uyari">İşlem bekliyor</span>
            }
            else
            {
                <span class="y-rozet y-rozet--basari">Hepsi yanıtlandı</span>
            }
        </p>
    </article>

    <article class="y-olcut y-olcut--neon">
        <p class="y-olcut__etiket">Okunmamış mesaj</p>
        <p class="y-olcut__deger">@ViewBag.OkunmamisMesaj</p>
        <p class="y-olcut__alt">Toplam @ViewBag.ToplamMesaj mesaj</p>
    </article>

    <article class="y-olcut y-olcut--neon">
        <p class="y-olcut__etiket">Onay bekleyen yorum</p>
        <p class="y-olcut__deger">@ViewBag.OnayBekleyenYorum</p>
        <p class="y-olcut__alt">Toplam @ViewBag.ToplamYorum yorum</p>
    </article>
</section>

@* --- Son 7 gün + menü durumu --- *@
<div class="y-ozet-alt">
    <section class="y-kart">
        <header class="y-kart__bas">
            <h2 class="y-kart__baslik">Son 7 gün</h2>
            <span class="y-rozet y-rozet--sonuk">Rezervasyon</span>
        </header>

        @* Sütunlar CSS ile çiziliyor; grafik kütüphanesi yüklemek
           yedi sayı için gereksiz ağırlık olurdu. *@
        <ul class="y-sutunlar">
            @for (int i = 0; i < gunler.Count; i++)
            {
                var sayi = i < sayilar.Count ? sayilar[i] : 0;
                var yuzde = (int)Math.Round(sayi * 100.0 / enYuksek);
                <li class="y-sutun">
                    <span class="y-sutun__deger y-sayi">@sayi</span>
                    <span class="y-sutun__cubuk" style="height:@(Math.Max(yuzde, 2))%"
                          role="img" aria-label="@gunler[i]: @sayi rezervasyon"></span>
                    <span class="y-sutun__etiket">@gunler[i]</span>
                </li>
            }
        </ul>
    </section>

    <section class="y-kart">
        <header class="y-kart__bas">
            <h2 class="y-kart__baslik">Menü durumu</h2>
        </header>

        <dl class="y-liste">
            <div class="y-liste__satir">
                <dt>Kategori</dt>
                <dd class="y-sayi">@ViewBag.ToplamKategori</dd>
            </div>
            <div class="y-liste__satir">
                <dt>Ürün</dt>
                <dd class="y-sayi">@ViewBag.ToplamUrun</dd>
            </div>
            <div class="y-liste__satir">
                <dt>Onaylı rezervasyon</dt>
                <dd class="y-sayi">@ViewBag.OnayliRezervasyon</dd>
            </div>
        </dl>

        <div class="y-hizli">
            <a class="y-dugme" href="/Kategori/Index">Kategoriler</a>
            <a class="y-dugme" href="/Urun/Index">Ürünler</a>
        </div>
    </section>
</div>
