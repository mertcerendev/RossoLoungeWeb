@using Newtonsoft.Json
@{
    Layout = null;
    ViewBag.AktifMenu = "ozet";
    // Veriler boş gelirse hata vermemesi için kontrol eklendi
    var gunlerJson = ViewBag.GrafikGunler != null ? JsonConvert.SerializeObject(ViewBag.GrafikGunler) : "[]";
    var sayilarJson = ViewBag.GrafikSayilar != null ? JsonConvert.SerializeObject(ViewBag.GrafikSayilar) : "[]";

    int okunmamisMesaj = ViewBag.OkunmamisMesaj ?? 0;
    int toplamMesaj = ViewBag.ToplamMesaj ?? 0;
    int onayBekleyenYorum = ViewBag.OnayBekleyenYorum ?? 0;
    int toplamYorum = ViewBag.ToplamYorum ?? 0;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Özeti | Rosso Lounge</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true">
</head>
<body class="panel">
    <a href="#icerik" class="icerige-atla">İçeriğe atla</a>

    @await Html.PartialAsync("~/Views/Admin/_YanMenu.cshtml")

    <main class="content" id="icerik">
        @await Html.PartialAsync("~/Views/Admin/_Bildirim.cshtml")

        <h2 class="mb-4">Hoş geldiniz, Yönetici</h2>

        <div class="row g-3 g-md-4 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card stat-card bg-danger p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div><h6>Bugünkü Rezervasyon</h6><h2>@ViewBag.BugunkuRezervasyon</h2></div>
                        <div class="icon-box"><i class="fas fa-calendar-day" aria-hidden="true"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card stat-card bg-warning p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div><h6>Bekleyen Rezervasyon</h6><h2>@ViewBag.BekleyenRezervasyon</h2></div>
                        <div class="icon-box"><i class="fas fa-clock" aria-hidden="true"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card stat-card bg-success p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div><h6>Onaylı Rezervasyon</h6><h2>@ViewBag.OnayliRezervasyon</h2></div>
                        <div class="icon-box"><i class="fas fa-check-circle" aria-hidden="true"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card stat-card bg-primary p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div><h6>Toplam Rezervasyon</h6><h2>@ViewBag.ToplamRezervasyon</h2></div>
                        <div class="icon-box"><i class="fas fa-users" aria-hidden="true"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 g-md-4 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="/Admin/Mesajlar" class="text-decoration-none d-block h-100">
                    <div class="card stat-card bg-dark p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6>Okunmamış Mesaj</h6>
                                <h2>@okunmamisMesaj <small class="opacity-75">/ @toplamMesaj</small></h2>
                            </div>
                            <div class="icon-box">
                                <i class="fas fa-envelope-open-text" aria-hidden="true"></i>
                            </div>
                        </div>
                        @if (okunmamisMesaj > 0)
                        {
                            <span class="rs-rozet rs-rozet-uyari mt-2 align-self-start">Okunmayı bekliyor</span>
                        }
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="/Admin/Yorumlar" class="text-decoration-none d-block h-100">
                    <div class="card stat-card bg-dark p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6>Onay Bekleyen Yorum</h6>
                                <h2>@onayBekleyenYorum <small class="opacity-75">/ @toplamYorum</small></h2>
                            </div>
                            <div class="icon-box">
                                <i class="fas fa-comment-dots" aria-hidden="true"></i>
                            </div>
                        </div>
                        @if (onayBekleyenYorum > 0)
                        {
                            <span class="rs-rozet rs-rozet-uyari mt-2 align-self-start">Onay bekliyor</span>
                        }
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="/Urun/Index" class="text-decoration-none d-block h-100">
                    <div class="card stat-card bg-secondary p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center">
                            <div><h6>Menüdeki Ürün</h6><h2>@ViewBag.ToplamUrun</h2></div>
                            <div class="icon-box"><i class="fas fa-utensils" aria-hidden="true"></i></div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="/Kategori/Index" class="text-decoration-none d-block h-100">
                    <div class="card stat-card bg-secondary p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center">
                            <div><h6>Kategori</h6><h2>@ViewBag.ToplamKategori</h2></div>
                            <div class="icon-box"><i class="fas fa-list" aria-hidden="true"></i></div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <div class="custom-card">
            <div class="card-header-custom">
                <div>
                    <h4 class="m-0">Son 7 Gün</h4>
                    <p class="rs-soluk small m-0">Günlük rezervasyon sayısı.</p>
                </div>
            </div>
            <div class="p-3 p-md-4">
                <canvas id="rezervasyonChart" height="100"
                        role="img" aria-label="Son yedi günün rezervasyon sayısını gösteren çizgi grafik"></canvas>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            var gunler = @Html.Raw(gunlerJson);
            var sayilar = @Html.Raw(sayilarJson);
            var marka = getComputedStyle(document.documentElement)
                .getPropertyValue('--renk-marka').trim() || '#e74c3c';

            var ctx = document.getElementById('rezervasyonChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: gunler,
                    datasets: [{
                        label: 'Rezervasyon',
                        data: sayilar,
                        borderColor: marka,
                        backgroundColor: 'rgba(231, 76, 60, 0.12)',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        })();
    </script>
    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/panel.js" asp-append-version="true"></script>
</body>
</html>
