@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifre Sıfırla | Rosso Lounge</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true">
</head>
<body class="giris-zemin">

    <main class="card p-4 shadow-lg">
        <div class="text-center mb-4">
            <h1 class="h3 fw-bold">Şifremi Unuttum</h1>
            <p class="description-text small">Kayıtlı e-posta adresinizi girin, yeni şifreniz bu adrese gönderilsin.</p>
        </div>

        @if (ViewBag.Basari != null)
        {
            <div class="rs-uyari rs-uyari-basari" role="status">
                <i class="fas fa-circle-check" aria-hidden="true"></i>
                <div>@ViewBag.Basari</div>
            </div>
            <a href="/Admin/Login" class="btn btn-outline-light w-100">Giriş Ekranına Dön</a>
        }
        else
        {
            if (ViewBag.Hata != null)
            {
                <div class="rs-uyari rs-uyari-hata" role="alert">
                    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                    <div>@ViewBag.Hata</div>
                </div>
            }

            <form action="/Admin/SifreSifirla" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label for="eposta" class="form-label description-text">E-posta adresiniz</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope" aria-hidden="true"></i></span>
                        <input type="email" id="eposta" name="Eposta" class="form-control"
                               placeholder="ornek@@rossolounge.com" required autocomplete="email">
                    </div>
                </div>
                <button type="submit" class="btn-reset">Şifreyi Gönder</button>
            </form>

            <a href="/Admin/Login" class="back-home">
                <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Giriş Ekranına Dön
            </a>
        }
    </main>

    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/panel.js" asp-append-version="true"></script>
</body>
</html>
