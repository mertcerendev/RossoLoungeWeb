@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifre Sıfırla | Rosso Lounge</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #1a1a1a;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            background: #2a2a2a;
            color: white;
            border: none;
            width: 100%;
            max-width: 400px;
            border-radius: 10px;
        }

        /* Buton Stilleri */
        .btn-reset {
            background: #e74c3c;
            color: white;
            border: none;
            transition: 0.3s;
        }

            .btn-reset:hover {
                background: #c0392b;
                color: white;
            }

        /* Input Alanı Stilleri */
        .form-control {
            background: #333;
            border: 1px solid #444;
            color: white !important; /* Yazı rengi BEYAZ */
        }

            .form-control:focus {
                background: #333;
                color: white !important;
                border-color: #e74c3c;
                box-shadow: 0 0 0 0.25rem rgba(231, 76, 60, 0.25);
            }

        .input-group-text {
            background: #444;
            border: 1px solid #444;
            color: #fff;
        }

        /* --- Placeholder (Silik Yazı) Rengini Beyaz Yapma --- */
        .form-control::placeholder {
            color: #e0e0e0 !important; /* Neredeyse tam beyaz */
            opacity: 1;
        }

        /* Üstteki açıklama yazısı */
        .description-text {
            color: #ddd;
        }
    </style>
</head>
<body>

    <div class="card p-4 shadow-lg">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Şifremi Unuttum</h3>
            <p class="description-text small">Kayıtlı e-posta adresinizi girin.</p>
        </div>

        @if (ViewBag.Basari != null)
        {
            <div class="alert alert-success text-center">
                <i class="fas fa-check-circle me-2"></i> @ViewBag.Basari
            </div>
            <div class="text-center mt-3">
                <a href="/Admin/Login" class="btn btn-outline-light btn-sm w-100">Giriş Ekranına Dön</a>
            </div>
        }
        else
        {
            if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger text-center">
                    <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Hata
                </div>
            }

            <form action="/Admin/SifreSifirla" method="post">
                <div class="mb-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" name="Eposta" class="form-control" placeholder="E-Posta Adresiniz" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-reset w-100 py-2 fw-bold">Şifreyi Gönder</button>
            </form>

            <div class="text-center mt-3">
                <a href="/Admin/Login" class="text-decoration-none text-secondary small">
                    <i class="fas fa-arrow-left me-1"></i> Giriş Ekranına Dön
                </a>
            </div>
        }
    </div>

</body>
</html>