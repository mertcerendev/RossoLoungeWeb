@*
    ŞİFREMİ UNUTTUM
    ===============================================================
    Girişle aynı kabuğu paylaşıyor: kenar çubuğu ve üst bar burada
    anlamsız olduğu için _AdminLayout kullanılmıyor.
    Uç değişmedi: POST /Admin/SifreSifirla (Eposta).
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Şifremi Unuttum · Rosso Panel</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/yonetim.css" asp-append-version="true">
</head>
<body class="yonetim">

    <main class="y-giris">
        <div class="y-giris__kart">
            <span class="y-giris__marka">Rosso <span>Panel</span></span>

            <h1 class="y-giris__baslik">Şifremi Unuttum</h1>
            <p class="y-giris__alt">Kayıtlı e-posta adresinizi girin, yeni şifreniz oraya gönderilsin.</p>

            @if (ViewBag.Basari != null)
            {
                <div class="y-ozet y-ozet--basari y-ozet--sayfa" role="status">
                    <i class="fas fa-circle-check" aria-hidden="true"></i>
                    <div>@ViewBag.Basari</div>
                </div>

                <a class="y-dugme y-dugme--tam" href="/Admin/Login">Giriş ekranına dön</a>
            }
            else
            {
                @if (ViewBag.Hata != null)
                {
                    <div class="y-ozet y-ozet--sayfa" role="alert">
                        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                        <div>@ViewBag.Hata</div>
                    </div>
                }

                <form class="y-giris__form" method="post" action="/Admin/SifreSifirla">
                    @Html.AntiForgeryToken()

                    <div class="y-alan">
                        <input class="y-alan__girdi" type="email" id="eposta" name="Eposta"
                               placeholder=" " autocomplete="email" maxlength="150" required autofocus>
                        <label class="y-alan__etiket" for="eposta">E-posta adresiniz</label>
                    </div>

                    <button type="submit" class="y-dugme y-dugme--birincil y-dugme--tam">
                        Şifreyi gönder
                    </button>
                </form>

                <div class="y-giris__ayak">
                    <a href="/Admin/Login">Giriş ekranına dön</a>
                    <a href="/" target="_blank" rel="noopener">Siteye dön</a>
                </div>
            }
        </div>
    </main>

    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/yonetim.js" asp-append-version="true"></script>
</body>
</html>
