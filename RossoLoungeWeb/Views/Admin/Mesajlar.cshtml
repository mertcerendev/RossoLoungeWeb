@model List<RossoLoungeWeb.Models.Iletisim>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Gelen Kutusu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            height: 100vh;
            background: #1a1a1a;
            color: white;
            padding: 20px;
            position: fixed;
            width: 250px;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .content {
            margin-left: 250px;
            padding: 30px;
        }

        .menu-item {
            display: block;
            padding: 12px 15px;
            color: #bbb;
            text-decoration: none;
            margin-bottom: 5px;
            border-radius: 8px;
            transition: 0.3s;
        }

            .menu-item:hover, .menu-item.active {
                background: #e74c3c;
                color: white;
            }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 40px;
            display: block;
            color: white;
            text-decoration: none;
        }

            .logo span {
                color: #e74c3c;
            }

        .unread {
            font-weight: bold;
            background-color: #fff3cd !important;
        }
        /* Okunmamış mesaj rengi */
        @@media (max-width: 768px) {
            .sidebar

        {
            width: 100%;
            height: auto;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .content {
            margin-left: 0;
            padding: 15px;
        }

        .menu-item {
            width: 100%;
            text-align: center;
        }

        }
    </style>
</head>
<body>
    <div class="sidebar">
        <a href="#" class="logo">ROSSO <span>PANEL</span></a>
        <a href="/Admin/Index" class="menu-item"><i class="fas fa-home me-2"></i> Özet</a>
        <a href="/Admin/Rezervasyonlar" class="menu-item"><i class="fas fa-calendar-check me-2"></i> Rezervasyonlar</a>
        <a href="/Kategori/Index" class="menu-item"><i class="fas fa-list me-2"></i> Kategoriler</a>
        <a href="/Urun/Index" class="menu-item"><i class="fas fa-utensils me-2"></i> Ürünler</a>
        <a href="/Admin/Mesajlar" class="menu-item active"><i class="fas fa-comment-dots me-2"></i> Mesajlar</a> <a href="/Admin/MailAyarlari" class="menu-item"><i class="fas fa-envelope me-2"></i> Mail Ayarları</a>
        <a href="/Admin/Profil" class="menu-item"><i class="fas fa-user-cog me-2"></i> Ayarlar</a>
        <a href="/" target="_blank" class="menu-item"><i class="fas fa-globe me-2"></i> Siteye Git</a>
        <a href="/Admin/CikisYap" class="menu-item bg-dark mt-3"><i class="fas fa-sign-out-alt me-2"></i> Çıkış Yap</a>
    </div>

    <div class="content">
        <h2 class="mb-4">Gelen Mesajlar</h2>
        <div class="card shadow-sm">
            <table class="table table-hover m-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Kimden</th>
                        <th>Konu (Mesaj)</th>
                        <th>Tarih</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.OkunduMu ? "" : "table-warning fw-bold")">
                            <td>
                                @item.AdSoyad
                                <br><small class="text-muted">@item.Email</small>
                            </td>
                            <td>
                                @if (item.Mesaj.Length > 50)
                                {
                                    @item.Mesaj.Substring(0, 50) <text>...</text>
                                }
                                else
                                {

                                    @item.Mesaj
                                }
                            </td>
                            <td>@item.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <a href="/Admin/MesajOku/@item.Id" class="btn btn-sm btn-info text-white">Oku</a>
                                <form action="/Admin/MesajSil/@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                    <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>