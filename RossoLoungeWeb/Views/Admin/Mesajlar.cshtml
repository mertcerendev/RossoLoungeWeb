@model List<RossoLoungeWeb.Models.Iletisim>
@*
    MESAJLAR (gelen kutusu)
    ===============================================================
    Uçlar değişmedi: /Admin/MesajOku/{id} (okuma), POST
    /Admin/MesajSil/{id}. Okunmamışlar satır vurgusuyla ayrılıyor.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Mesajlar";
    ViewData["AltBaslik"] = "İletişim formundan gelenler";
    ViewData["Aktif"] = "mesajlar";
    ViewData["AramaHedefi"] = "mesaj-tablosu";
    ViewData["AramaYerTutucu"] = "Ad, e-posta veya mesajda ara";

    var okunmamis = Model.Count(x => !x.OkunduMu);
    ViewData["OkunmamisMesaj"] = (int?)okunmamis;
    ViewData["Bildirim"] = (int?)okunmamis;
}

@section Eylemler {
    <span class="y-rozet y-rozet--sonuk">
        Toplam <span data-tablo-sayac>@Model.Count</span>
    </span>
    @if (okunmamis > 0)
    {
        <span class="y-rozet y-rozet--uyari">@okunmamis okunmadı</span>
    }
}

@if (Model.Count == 0)
{
    <div class="y-bos">
        <i class="y-bos__im fas fa-inbox" aria-hidden="true"></i>
        <h2 class="y-bos__baslik">Gelen kutusu boş</h2>
        <p class="y-bos__alt">Sitedeki iletişim formundan gönderilen mesajlar burada listelenir.</p>
    </div>
}
else
{
    <div class="y-tablo-sarmal">
        <table class="y-tablo" id="mesaj-tablosu">
            <caption class="y-gizli">İletişim formundan gelen mesajlar</caption>
            <thead>
                <tr>
                    <th scope="col">Kimden</th>
                    <th scope="col">Mesaj</th>
                    <th scope="col">Tarih</th>
                    <th scope="col">Durum</th>
                    <th scope="col" class="y-tablo__eylem"><span class="y-gizli">İşlemler</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.OkunduMu ? null : "y-satir--dikkat")">
                        <td>
                            <span class="y-tablo__ad">@item.AdSoyad</span>
                            <span class="y-tablo__ikincil">@item.Email</span>
                        </td>
                        <td class="y-tablo__not">
                            @(item.Mesaj.Length > 70 ? item.Mesaj.Substring(0, 70) + "…" : item.Mesaj)
                        </td>
                        <td class="y-sayi">@item.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (item.OkunduMu)
                            {
                                <span class="y-rozet y-rozet--sonuk">Okundu</span>
                            }
                            else
                            {
                                <span class="y-rozet y-rozet--uyari">Yeni</span>
                            }
                        </td>
                        <td class="y-tablo__eylem">
                            <div class="y-eylemler">
                                <a class="y-hayalet" href="/Admin/MesajOku/@item.Id"
                                   title="Oku"
                                   aria-label="@item.AdSoyad kişisinden gelen mesajı oku">
                                    <i class="fas fa-envelope-open-text" aria-hidden="true"></i>
                                </a>

                                <a class="y-hayalet" href="mailto:@item.Email"
                                   title="E-posta ile yanıtla"
                                   aria-label="@item.AdSoyad kişisine e-posta ile yanıt yaz">
                                    <i class="fas fa-reply" aria-hidden="true"></i>
                                </a>

                                <form method="post" action="/Admin/MesajSil/@item.Id"
                                      onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="y-hayalet y-hayalet--tehlike"
                                            title="Sil"
                                            aria-label="@item.AdSoyad kişisinden gelen mesajı sil">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
