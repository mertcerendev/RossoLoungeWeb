@model RossoLoungeWeb.Models.ProfilModeli
@*
    AYARLAR — YÖNETİCİ HESABI
    ===============================================================
    Uç değişmedi: POST /Admin/ProfilGuncelle (Id, KullaniciAdi,
    Eposta, Sifre). Şifre alanı boş bırakılırsa mevcut şifre korunur.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Ayarlar";
    ViewData["AltBaslik"] = "Panele giriş bilgileriniz";
    ViewData["Aktif"] = "ayarlar";
}

@section Eylemler {
    <a class="y-dugme" href="/Admin/MailAyarlari">
        <i class="fas fa-envelope" aria-hidden="true"></i> Mail ayarları
    </a>
}

@if (ViewBag.Mesaj != null)
{
    <div class="y-ozet y-ozet--basari y-ozet--sayfa" role="status">
        <i class="fas fa-circle-check" aria-hidden="true"></i>
        <div>@ViewBag.Mesaj</div>
    </div>
}
@if (ViewBag.Hata != null)
{
    <div class="y-ozet y-ozet--sayfa" role="alert">
        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
        <div>@ViewBag.Hata</div>
    </div>
}
@await Html.PartialAsync("_YonetimDogrulama")

<form class="y-form" method="post" action="/Admin/ProfilGuncelle">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id">

    <div class="y-form__izgara">
        <div class="y-form__alan">
            <label class="y-form__etiket" for="kullaniciAdi">
                Kullanıcı adı <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            <input class="y-girdi" type="text" id="kullaniciAdi" name="KullaniciAdi"
                   value="@Model.KullaniciAdi" autocomplete="username" maxlength="50" required>
        </div>

        <div class="y-form__alan">
            <label class="y-form__etiket" for="eposta">
                E-posta <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            <input class="y-girdi" type="email" id="eposta" name="Eposta"
                   value="@Model.Eposta" autocomplete="email" maxlength="150"
                   required aria-describedby="eposta-yardim">
            <p class="y-form__yardim" id="eposta-yardim">Şifre sıfırlama bağlantısı bu adrese gönderilir.</p>
        </div>
    </div>

    <div class="y-form__alan">
        <label class="y-form__etiket" for="yeniSifre">Yeni şifre</label>

        <div class="y-alan">
            <input class="y-girdi" type="password" id="yeniSifre" name="Sifre"
                   placeholder="Değiştirmek için yazın…" autocomplete="new-password"
                   aria-describedby="sifre-yardim">
            <button type="button" class="y-alan__eylem" data-sifre-gor
                    aria-controls="yeniSifre" aria-label="Şifreyi göster">
                <i class="fas fa-eye" aria-hidden="true"></i>
            </button>
        </div>

        <p class="y-form__yardim" id="sifre-yardim">Boş bırakırsanız mevcut şifreniz değişmez.</p>
    </div>

    <div class="y-form__ayak">
        <button type="submit" class="y-dugme y-dugme--birincil">Güncelle</button>
    </div>
</form>
