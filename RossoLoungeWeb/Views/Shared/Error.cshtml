@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Bir Hata Oluştu";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bir Hata Oluştu | Rosso Lounge Bistro</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">

    <style>
        /* Hata sayfası tek başına ayakta durur (style.css yüklenmez);
           tüm değerler theme.css tokenlarından gelir. */
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--bosluk-5);
            background: var(--siyah);
            color: var(--yz-metin);
            text-align: center;
        }

        .hata-kutusu {
            max-width: 520px;
        }

        .hata-ikon {
            margin-bottom: var(--bosluk-6);
            color: var(--renk-marka);
            font-size: var(--olcek-4xl);
        }

        .hata-kutusu h1 {
            margin: 0 0 var(--bosluk-4);
            font-family: var(--font-baslik);
            font-size: var(--olcek-2xl);
            line-height: var(--satir-sik);
        }

        .hata-kutusu p {
            margin: 0 0 var(--bosluk-8);
            color: var(--yz-metin-soluk);
            line-height: var(--satir-genis);
        }

        .referans {
            margin-top: var(--bosluk-8);
            color: var(--gri-400); /* koyu zeminde 6.86:1; --gri-600 2.30 kalıyordu */
            font-size: var(--olcek-xs);
            overflow-wrap: anywhere;
        }
    </style>
</head>
<body class="rs-koyu">
    <main class="hata-kutusu">
        <div class="hata-ikon"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></div>
        @{
            var kod = ViewBag.DurumKodu as int?;
            var bulunamadi = kod == 404;
        }

        <h1>@(bulunamadi ? "Sayfa bulunamadı" : "Bir şeyler ters gitti")</h1>
        <p>
            @if (bulunamadi)
            {
                <text>
                    Aradığınız sayfa taşınmış veya hiç var olmamış olabilir.
                    Menümüze göz atabilir ya da ana sayfaya dönebilirsiniz.
                </text>
            }
            else
            {
                <text>İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen birazdan tekrar deneyin.</text>
            }
            Sorun devam ederse bizi
            <a href="tel:+902667121313" class="rs-vurgu">+90 266 712 13 13</a>
            numaradan arayabilirsiniz.
        </p>
        <a href="/" class="rs-btn rs-btn-birincil">Ana Sayfaya Dön</a>
        @if (bulunamadi)
        {
            <a href="/menu" class="rs-btn rs-btn-hayalet">Menüye Bak</a>
        }

        @if (Model.ShowRequestId)
        {
            <div class="referans">Referans: <code>@Model.RequestId</code></div>
        }
    </main>
</body>
</html>
