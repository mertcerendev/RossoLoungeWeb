@model List<RossoLoungeWeb.Models.Kategori>
@{
    Layout = null;
    var yil = RossoLoungeWeb.Services.TurkiyeSaati.Simdi.Year;
    var yerTutucu = "/img/site/sunum.jpg";
    var toplamUrun = Model?.Sum(k => k.Urunler.Count) ?? 0;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menü | Rosso Lounge Bistro</title>
    <meta name="description" content="Rosso Lounge Bistro menüsü — başlangıçlar, ana yemekler, pizzalar, tatlılar ve içecekler.">
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/rosso-tema.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/rosso-bilesenler.css" asp-append-version="true">
</head>
<body>
    @* Sıvı imleç — yalnızca fare olan cihazlarda *@
    <div class="imlec" aria-hidden="true">
        <span class="imlec__halka"></span>
        <span class="imlec__nokta"></span>
    </div>

    <a href="#icerik" class="atla">İçeriğe atla</a>
    <div class="nav-perde" aria-hidden="true"></div>

    <header class="nav" id="navbar">
        <div class="kap nav__ic">
            <a href="/" class="nav__marka">ROSSO <span>LOUNGE</span></a>

            <nav aria-label="Ana menü">
                <ul class="nav__menu">
                    <li><a href="/" class="nav__link">Ana Sayfa</a></li>
                    <li><a href="/#about" class="nav__link">Hakkımızda</a></li>
                    <li><a href="/Home/Menu" class="nav__link nav__link--aktif">Menü</a></li>
                    <li><a href="/#gallery" class="nav__link">Galeri</a></li>
                    <li><a href="/#reviews" class="nav__link">Yorumlar</a></li>
                    <li><a href="/#contact" class="nav__link">İletişim</a></li>
                    <li class="nav__mobil"><a href="/#rezervasyon" class="nav__eylem">Rezervasyon</a></li>
                </ul>
            </nav>

            <a href="/#rezervasyon" class="nav__eylem nav__eylem--masaustu">Rezervasyon</a>

            <button type="button" class="nav__hamburger" aria-label="Menüyü aç veya kapat" aria-expanded="false">
                <span class="nav__cizgi"></span>
            </button>
        </div>
    </header>

    <main id="icerik">
        <section class="menu menu--sayfa">
            <div class="kap">
                <header class="menu__bas">
                    <p class="menu__ustbaslik">Menü</p>
                    <h2 class="menu__baslik">Mutfağımızın <em>tamamı</em></h2>
                    <p class="menu__alt">
                        @toplamUrun tabak, @(Model?.Count ?? 0) kategori. Malzemeler günlük,
                        tarifler sabit; mevsime göre birkaç tabak değişir.
                    </p>
                </header>

                @if (Model != null && Model.Count > 0)
                {
                    <nav class="menu__filtre" aria-label="Menü kategorileri">
                        <div class="menu__filtre-ic" role="tablist">
                            <button type="button" class="menu__sekme menu__sekme--aktif"
                                    role="tab" aria-selected="true" data-filtre="tumu">
                                Tümü
                            </button>
                            @foreach (var kategori in Model)
                            {
                                <button type="button" class="menu__sekme"
                                        role="tab" aria-selected="false" tabindex="-1"
                                        data-filtre="kat-@kategori.Id">
                                    @kategori.Ad
                                </button>
                            }
                        </div>
                    </nav>

                    <div class="menu__liste" id="menu-liste">
                        @foreach (var kategori in Model)
                        {
                            foreach (var urun in kategori.Urunler)
                            {
                                <article class="menu__kalem"
                                         data-kategori="kat-@kategori.Id"
                                         data-gorsel="@(string.IsNullOrEmpty(urun.ResimUrl) || urun.ResimUrl.StartsWith("http") ? yerTutucu : urun.ResimUrl)">
                                    <div class="menu__kalem-ana">
                                        <h3 class="menu__ad">@urun.Ad</h3>
                                        @if (!string.IsNullOrWhiteSpace(urun.Aciklama))
                                        {
                                            <p class="menu__aciklama">@urun.Aciklama</p>
                                        }
                                    </div>

                                    <div class="menu__fiyatlar">
                                        @if (urun.FiyatBuyuk.HasValue)
                                        {
                                            <span class="menu__fiyat">
                                                <span class="menu__fiyat-tur">@(string.IsNullOrEmpty(urun.FiyatTur) ? "Orta" : urun.FiyatTur)</span>
                                                @urun.Fiyat.ToString("N0")<span class="menu__para">₺</span>
                                            </span>
                                            <span class="menu__fiyat">
                                                <span class="menu__fiyat-tur">@(string.IsNullOrEmpty(urun.FiyatBuyukTur) ? "Büyük" : urun.FiyatBuyukTur)</span>
                                                @urun.FiyatBuyuk.Value.ToString("N0")<span class="menu__para">₺</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="menu__fiyat">
                                                @urun.Fiyat.ToString("N0")<span class="menu__para">₺</span>
                                            </span>
                                        }
                                    </div>

                                    <span class="menu__kategori-etiket">@kategori.Ad</span>
                                </article>
                            }
                        }
                    </div>

                    <p class="menu__bos" hidden>Bu kategoride şu an ürün bulunmuyor.</p>
                }
                else
                {
                    <p class="menu__bos">Menü yakında burada olacak.</p>
                }

                <div class="menu__geri">
                    <a href="/#rezervasyon" class="btn btn--sampanya">Masa Ayırt</a>
                </div>
            </div>

            <div class="menu__onizleme" aria-hidden="true">
                <img class="menu__onizleme-foto" src="" alt="">
            </div>
        </section>
    </main>

    <footer>
        <div class="kap">
            <div class="alt-serit">
                <p>&copy; @yil Rosso Lounge Bistro. Tüm hakları saklıdır.</p>
                <div class="footer-signature">Software &amp; Design by <span class="developer-name">Mert CEREN</span></div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.20/dist/lenis.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/Flip.min.js"></script>
    <script src="~/js/rosso-hareket.js" asp-append-version="true"></script>
    <script src="~/js/ortak.js" asp-append-version="true"></script>
</body>
</html>
