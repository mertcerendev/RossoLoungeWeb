@model List<RossoLoungeWeb.Models.Kategori>
@{
    Layout = null;

    var kategoriler = Model ?? new List<RossoLoungeWeb.Models.Kategori>();

    // Kültür Program.cs'te InvariantCulture'a sabitli; ekrandaki fiyatlar Türkçe olsun.
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var yil = RossoLoungeWeb.Services.TurkiyeSaati.Simdi.Year;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menü | Rosso Lounge Bistro</title>
    <meta name="description" content="Rosso Lounge Bistro menüsü — başlangıçlar, ana yemekler, tatlılar ve içecekler. Bandırma.">
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

    <style>
        /* style.css'te karşılığı olan .menu-header / .category-title / .menu-card /
           .menu-info / .price kuralları silindi — tek kaynak style.css.
           Aşağıdakiler style.css'te YOK; Tasarım ajanına bildirildi. */
        .menu-header p {
            margin: 0;
            font-size: var(--olcek-lg);
            opacity: 0.9;
        }

        /* Kategori filtresi */
        .menu-filtre {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: var(--bosluk-2);
            margin-bottom: var(--bolum-bosluk);
        }

        /* Ürünün görseli yoksa zarif yer tutucu */
        .gorsel-yok {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 200px;
            background: var(--yz-zemin-vurgu);
            color: var(--renk-marka);
            font-size: var(--olcek-3xl);
            opacity: 0.55;
        }

        .menu-item {
            display: flex;
            flex-direction: column;
        }

        .menu-info {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

            .menu-info h3 {
                margin-top: 0;
            }

            .menu-info p {
                margin: 0 0 var(--bosluk-4);
            }

        /* Tek ya da çift fiyat satırı (Orta / Büyük) */
        .fiyat-satiri {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: baseline;
            gap: var(--bosluk-4);
            margin-top: auto;
            padding-top: var(--bosluk-3);
            border-top: 1px solid var(--yz-kenar);
        }

        .fiyat-secenek {
            min-width: 0;
        }

        .fiyat-etiket {
            display: block;
            color: var(--yz-metin-soluk);
            font-size: var(--olcek-xs);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .fiyat-satiri .price {
            margin-top: 0;
        }
    </style>
</head>

<body>
    <a href="#icerik" class="icerige-atla">İçeriğe atla</a>

    <header id="navbar" class="dark-header">
        <div class="container nav-container">
            <a href="/Home/Index" class="logo">ROSSO <span>LOUNGE</span></a>
            <nav aria-label="Ana menü">
                <ul class="nav-links">
                    <li><a href="/Home/Index#home">Ana Sayfa</a></li>
                    <li><a href="/Home/Index#about">Hakkımızda</a></li>
                    <li><a href="/Home/Menu" class="active">Menü</a></li>
                    <li><a href="/Home/Index#gallery">Galeri</a></li>
                    <li><a href="/Home/Index#reviews">Yorumlar</a></li>
                    <li><a href="/Home/Index#contact">İletişim</a></li>
                    <li class="mobile-only-reserve-btn">
                        <a href="/Home/Index#rezervasyon" class="btn-reserve">Rezervasyon Yap</a>
                    </li>
                </ul>
            </nav>
            <a href="/Home/Index#rezervasyon" class="btn-reserve desktop-only-reserve-btn">Rezervasyon Yap</a>
            <button type="button" class="hamburger" aria-label="Menüyü aç / kapat">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
        </div>
    </header>

    <main id="icerik">
        <div class="menu-header">
            <div class="container">
                <h1>Lezzetlerimiz</h1>
                <p>Dünya mutfağından seçkin tatlar</p>
            </div>
        </div>

        <section class="section-padding">
            <div class="container">

                @if (kategoriler.Count == 0)
                {
                    <div class="rs-bos-durum">
                        <i class="fas fa-utensils" aria-hidden="true"></i>
                        <h3>Menü hazırlanıyor</h3>
                        <p>Lezzetlerimiz çok yakında burada olacak. Bu arada bize telefonla ulaşabilir veya masanızı ayırtabilirsiniz.</p>
                        <a href="/Home/Index#rezervasyon" class="rs-btn rs-btn-ikincil rs-btn-sm">Rezervasyon Yap</a>
                    </div>
                }
                else
                {
                    <nav class="menu-filtre" aria-label="Kategoriye göre filtrele">
                        <button type="button" class="rs-btn rs-btn-sm rs-btn-birincil menu-filtre-btn"
                                data-kategori="tumu" aria-pressed="true">Tümü</button>
                        @foreach (var kategori in kategoriler)
                        {
                            <button type="button" class="rs-btn rs-btn-sm rs-btn-ikincil menu-filtre-btn"
                                    data-kategori="@kategori.Id" aria-pressed="false">@kategori.Ad</button>
                        }
                    </nav>

                    @foreach (var kategori in kategoriler)
                    {
                        <section class="menu-category" id="kategori-@kategori.Id" data-kategori="@kategori.Id"
                                 aria-labelledby="kategori-baslik-@kategori.Id">
                            <div class="text-center">
                                <h2 class="category-title" id="kategori-baslik-@kategori.Id">@kategori.Ad</h2>
                            </div>

                            <div class="menu-grid">
                                @foreach (var urun in kategori.Urunler)
                                {
                                    <article class="menu-item menu-card rs-koyu">
                                        @if (!string.IsNullOrEmpty(urun.ResimUrl))
                                        {
                                            <img src="@urun.ResimUrl" alt="@urun.Ad" loading="lazy">
                                        }
                                        else
                                        {
                                            <div class="gorsel-yok" aria-hidden="true"><i class="fas fa-utensils"></i></div>
                                        }

                                        <div class="menu-info">
                                            <h3>@urun.Ad</h3>
                                            @if (!string.IsNullOrWhiteSpace(urun.Aciklama))
                                            {
                                                <p>@urun.Aciklama</p>
                                            }

                                            <div class="fiyat-satiri">
                                                @if (urun.FiyatBuyuk.HasValue && urun.FiyatBuyuk > 0)
                                                {
                                                    <span class="fiyat-secenek">
                                                        <span class="fiyat-etiket">@(string.IsNullOrWhiteSpace(urun.FiyatTur) ? "Orta" : urun.FiyatTur)</span>
                                                        <span class="price">@urun.Fiyat.ToString("#,##0.##", tr) ₺</span>
                                                    </span>
                                                    <span class="fiyat-secenek">
                                                        <span class="fiyat-etiket">@(string.IsNullOrWhiteSpace(urun.FiyatBuyukTur) ? "Büyük" : urun.FiyatBuyukTur)</span>
                                                        <span class="price">@urun.FiyatBuyuk.Value.ToString("#,##0.##", tr) ₺</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="fiyat-secenek">
                                                        <span class="price">@urun.Fiyat.ToString("#,##0.##", tr) ₺</span>
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>
                    }

                    <div class="text-center mt-5">
                        <a href="/Home/Index#rezervasyon" class="btn-main">Masanızı Ayırtın</a>
                    </div>
                }

            </div>
        </section>
    </main>

    <footer>
        <p>&copy; @yil Rosso Lounge Bistro. Tüm hakları saklıdır.</p>
        <div class="footer-signature">
            Software &amp; Design by <span class="developer-name">Mert CEREN</span>
        </div>
    </footer>

    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
</body>
</html>
