@model List<RossoLoungeWeb.Models.Kategori>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menü | Rosso Lounge Bistro</title>
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">

    <style>
        .menu-header {
            background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1559339352-11d035aa65de?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80');
            background-size: cover;
            background-position: center;
            height: 40vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-align: center;
            margin-top: 60px;
        }

        .category-title {
            text-align: center;
            font-size: 2.2rem;
            margin-bottom: 2.5rem;
            color: #e74c3c;
            position: relative;
            display: inline-block;
            padding-bottom: 10px;
            text-transform: uppercase;
            font-weight: bold;
        }

            .category-title::after {
                content: '';
                display: block;
                width: 60px;
                height: 4px;
                background: #e74c3c;
                margin: 10px auto 0;
                border-radius: 2px;
            }

        .menu-card {
            background: #2a2a2a;
            border-radius: 10px;
            overflow: hidden;
            transition: transform 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            height: 100%;
            display: flex;
            flex-direction: column;
        }

            .menu-card:hover {
                transform: translateY(-5px);
            }

            .menu-card img {
                width: 100%;
                height: 250px;
                object-fit: cover;
            }

        .menu-info {
            padding: 1.5rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .menu-info h3 {
                color: #fff;
                font-size: 1.3rem;
                margin-bottom: 0.5rem;
            }

            .menu-info p {
                color: #ccc;
                font-size: 0.9rem;
                font-weight: 300;
                min-height: 40px;
            }

        /* Fiyat Stilleri (GÜNCELLENDİ) */
        .price-container {
            border-top: 1px solid #444;
            padding-top: 10px;
            margin-top: 10px;
        }

        .price {
            color: #e74c3c;
            font-weight: bold;
            font-size: 1.2rem;
            display: block;
        }

        .price-label {
            color: #aaa;
            font-size: 0.85rem;
            font-weight: normal;
            margin-right: 5px;
        }
    </style>
</head>

<body>

    <header id="navbar" class="dark-header">
        <div class="container nav-container">
            <a href="/Home/Index" class="logo">ROSSO <span>LOUNGE</span></a>
            <nav>
                <ul class="nav-links">
                    <li><a href="/Home/Index#home">Ana Sayfa</a></li>
                    <li><a href="/Home/Index#about">Hakkımızda</a></li>
                    <li><a href="/Home/Index#menu">Menü</a></li>
                    <li><a href="/Home/Index#gallery">Galeri</a></li>
                    <li><a href="/Home/Index#reviews">Yorumlar</a></li>
                    <li><a href="/Home/Index#contact">İletişim</a></li>
                    <li class="mobile-only-reserve-btn">
                        <a href="/Home/Index#rezervasyon" class="btn-reserve">Rezervasyon Yap</a>
                    </li>
                </ul>
            </nav>
            <a href="/Home/Index#rezervasyon" class="btn-reserve desktop-only-reserve-btn">Rezervasyon Yap</a>
            <div class="hamburger">
                <i class="fas fa-bars"></i>
            </div>
        </div>
    </header>

    <div class="menu-header">
        <div>
            <h1 style="font-size: 3.5rem; margin-bottom: 0.5rem; font-weight: 700;">LEZZETLERİMİZ</h1>
            <p style="font-size: 1.3rem; opacity: 0.9;">Dünya mutfağından seçkin tatlar</p>
        </div>
    </div>

    <section class="section-padding" style="background-color: #ffffff;">
        <div class="container">

            @if (Model.Count == 0)
            {
                <div class="alert alert-warning text-center p-5">
                    <h4>Henüz menü eklenmemiş.</h4>
                </div>
            }
            else
            {
                @foreach (var kategori in Model)
                {
                    if (kategori.Urunler != null && kategori.Urunler.Count > 0)
                    {
                        <div class="mb-5">

                            <div class="text-center">
                                <h2 class="category-title">@kategori.Ad</h2>
                            </div>

                            <div class="row g-4 justify-content-center">
                                @foreach (var urun in kategori.Urunler)
                                {
                                    <div class="col-lg-4 col-md-6 col-12">
                                        <div class="menu-card">
                                            @if (!string.IsNullOrEmpty(urun.ResimUrl))
                                            {
                                                <img src="@urun.ResimUrl" alt="@urun.Ad">
                                            }
                                            else
                                            {
                                                <img src="https://placehold.co/600x400?text=Resim+Yok" alt="Resim Yok">
                                            }

                                            <div class="menu-info">
                                                <div>
                                                    <h3>@urun.Ad</h3>
                                                    <p>@urun.Aciklama</p>
                                                </div>

                                                <div class="price-container mt-3">
                                                    @if (urun.FiyatBuyuk != null && urun.FiyatBuyuk > 0)
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <span class="price-label">@(string.IsNullOrEmpty(urun.FiyatTur) ? "Orta" : urun.FiyatTur):</span>
                                                                <span class="price">@urun.Fiyat.ToString("0.#") ₺</span>
                                                            </div>
                                                            <div class="text-end">
                                                                <span class="price-label">@(string.IsNullOrEmpty(urun.FiyatBuyukTur) ? "Büyük" : urun.FiyatBuyukTur):</span>
                                                                <span class="price">@urun.FiyatBuyuk.Value.ToString("0.#") ₺</span>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-center">
                                                            <span class="price">@urun.Fiyat.ToString("0.#") ₺</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    }
                }
            }

        </div>
    </section>

    <footer>
        <p>© 2025 Rosso Lounge Bistro. Tüm hakları saklıdır.</p>
        <div class="footer-signature">
            Software & Design by <span class="developer-name">Mert CEREN</span>
        </div>
    </footer>

    <script src="~/js/script.js"></script>
</body>
</html>