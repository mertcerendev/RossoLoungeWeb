@model List<RossoLoungeWeb.Models.Yorum>
@{
    ViewData["Baslik"] = "Rosso Lounge Bistro | Bandırma";
    ViewData["Aciklama"] = "Rosso Lounge Bistro — Bandırma'da modern atmosfer, taze lezzetler ve imza kokteyller. Online masa rezervasyonu yapın.";

    // Girişi aşağıdaki .sahne-perde üstleniyor; _Layout'un geçiş perdesi
    // bu sayfada KAPALI başlamasın (ikisi üst üste binerdi).
    ViewData["Giris"] = "sinematik";

    // Öne çıkan ürünler HomeController.Index'ten geliyor (SiraNo'ya göre ilk 3).
    var oneCikanlar = ViewBag.OneCikanlar as List<RossoLoungeWeb.Models.Urun> ?? new List<RossoLoungeWeb.Models.Urun>();
    var yorumlar = Model ?? new List<RossoLoungeWeb.Models.Yorum>();

    // Kültür Program.cs'te InvariantCulture'a sabitlendi (form verisi için).
    // Ekranda gösterilen fiyat/tarih Türkçe olsun diye kültürü açıkça belirtiyoruz.
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var yil = RossoLoungeWeb.Services.TurkiyeSaati.Simdi.Year;

    // GALERİ SERGİSİ — kareler tek kaynaktan geliyor.
    // Görseller veritabanına taşındığında YALNIZCA bu atama değişir
    // (ör. ViewBag.Galeri as List<Galeri>); aşağıdaki @foreach bloğu
    // ve tüm animasyon kancaları aynen çalışmaya devam eder.
    //
    // ÇIKARILANLAR — burası bar değil, restoran:
    //   bar.jpg      → içki rafı ve bar tezgâhı
    //   paylasim.jpg → kadrajın solunda yarım içilmiş bira bardağı
    //   ic-mekan.jpg → solunda aydınlatmalı şarap dolabı; o şerit
    //                  kesilip salon.jpg olarak kaydedildi
    // Hakkımızda'daki aksam-masa.jpg bilerek DURUYOR: kaldırılmıştı,
    // istek üzerine geri alındı.
    // Yerlerine mekânın KENDİ fotoğrafları geldi (img/urunler'den
    // kopyalandı, kaynak dosyalara dokunulmadı): firindan.jpg, kahve.jpg.
    var galeriKareleri = new[]
    {
        new { Gorsel = "/img/site/salon.jpg",    Etiket = "Salon",         Alt = "Pirinç paravanlı salon, hazırlanmış masalar",                 Genis = true  },
        new { Gorsel = "/img/site/firindan.jpg", Etiket = "Fırından",      Alt = "Koyu mermer tabakta, parmesanla servis edilen fırın makarnası", Genis = false },
        new { Gorsel = "/img/site/bahce.jpg",    Etiket = "Deniz Terası",  Alt = "Deniz manzaralı, tenteli açık hava terası",                   Genis = true  },
        new { Gorsel = "/img/site/sef.jpg",      Etiket = "Mutfak",        Alt = "Şefimiz servis öncesi malzemeleri hazırlarken",               Genis = false },
        new { Gorsel = "/img/site/sunum.jpg",    Etiket = "Sunum",         Alt = "Tepeden çekilmiş, tabakta sunulan ana yemekler",              Genis = false },
        new { Gorsel = "/img/site/kahve.jpg",    Etiket = "Kahve",         Alt = "Altın yaldızlı fincanda Türk kahvesi ve porselen demlik",     Genis = false },
        new { Gorsel = "/img/site/sofra.jpg",    Etiket = "Akşam Sofrası", Alt = "Mermer masada paylaşılan tabaklar; makarna, pizza ve salata", Genis = true  }
    };
}

    @* ---- Sinematik perde: sayaç dolar, ardından iki panel yırtılır ---- *@
    <div class="sahne-perde" aria-hidden="true">
        <div class="sahne-perde__marka">ROSSO <span>LOUNGE</span></div>
        <div class="sahne-perde__sayac">000</div>
    </div>
    <div class="sahne-perde__panel sahne-perde__panel--ust" aria-hidden="true"></div>
    <div class="sahne-perde__panel sahne-perde__panel--alt" aria-hidden="true"></div>

    @* Controller'lar rezervasyon/mesaj/yorum sonucunu TempData'ya yazıyordu
       ama ziyaretçi sitesinde hiçbir yerde okunmuyordu — form gönderen
       kullanıcı sessizlikle karşılaşıyordu. Toast bileşeni script.js'e bağlı
       (otomatik kapanma + kapat düğmesi). *@
    @if (TempData["Mesaj"] != null)
    {
        <div class="toast-bildirim basarili" role="status">
            <svg class="toast-ikon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
            <div>@TempData["Mesaj"]</div>
            <button type="button" class="toast-kapat" aria-label="Bildirimi kapat">&times;</button>
        </div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="toast-bildirim hata" role="alert">
            <svg class="toast-ikon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3.5 22 20H2Z"/><path d="M12 9.5v4.5"/><circle cx="12" cy="17" r=".9" fill="currentColor" stroke="none"/></svg>
            <div>@TempData["Hata"]</div>
            <button type="button" class="toast-kapat" aria-label="Bildirimi kapat">&times;</button>
        </div>
    }



    <main id="icerik">
        <section id="home" class="hero">
            <div class="hero__zemin" aria-hidden="true"></div>
            <div class="hero__perde" aria-hidden="true"></div>

            <div class="hero__ic">
                <p class="hero__ustbaslik">Bandırma · Marmara kıyısında</p>

                <h1 class="hero__baslik">
                    Lezzetin ve konforun
                    <em>buluşma noktası</em>
                </h1>

                <p class="hero__alt">
                    Sıcak bir ışık, iyi bir sohbet ve hak ettiği tabaklar.
                </p>

                <div class="hero__eylemler">
                    <a href="#rezervasyon" class="btn btn--sampanya">Masa Ayırt</a>
                    <a href="/menu" class="btn btn--hat">Menüyü Keşfet</a>
                </div>

                @* Açık/kapalı rozeti kaldırıldı; saat tek başına ortada.
                   Durum bilgisi iletişim bölümünde duruyor. *@
                <p class="hero__durum">
                    <span class="hero__saat">Her gün 11.30 – 00.00</span>
                </p>
            </div>

            <a href="#hakkimizda" class="hero__kaydir" aria-label="Aşağı kaydır"></a>
        </section>

        @* ============================================================
           HAKKIMIZDA
           Razor notu: bu blok olduğu gibi Views/Home/_Hakkinda.cshtml
           dosyasına taşınabilir ve Index'ten
           @await Html.PartialAsync("_Hakkinda") ile çağrılabilir.
           Dışarıdan veri almıyor, bağımsız bir partial.
           ============================================================ *@
        <section id="hakkimizda" class="hakkinda">
            <div class="kap hakkinda__izgara">

                @* --- Asimetrik görsel kompozisyon: iki çerçeve hafifçe binişik --- *@
                <div class="hakkinda__gorseller">
                    <figure class="hakkinda__cerceve hakkinda__cerceve--genis" data-parallax="-14">
                        <img class="hakkinda__foto"
                             src="/img/site/aksam-masa.jpg"
                             alt="Akşam ışığında hazırlanmış masa, kadehler ve tabaklar"
                             loading="eager" decoding="async" width="1800" height="1200">
                    </figure>

                    <figure class="hakkinda__cerceve hakkinda__cerceve--dar" data-parallax="16">
                        <img class="hakkinda__foto"
                             src="/img/site/sef.jpg"
                             alt="Şefimiz servis öncesi malzemeleri hazırlarken"
                             loading="lazy" width="1200" height="1800">
                    </figure>

                    <span class="hakkinda__yil" aria-hidden="true">
                        <em>2019</em>
                        <span>o günden beri</span>
                    </span>
                </div>

                @* --- Metin --- *@
                <div class="hakkinda__metin">
                    <p class="hakkinda__ustbaslik">Hakkımızda</p>

                    <h2 class="hakkinda__baslik" data-kelime-acilis>
                        Sıradanlığın ötesinde <em>bir gastronomi</em>
                    </h2>

                    <div class="hakkinda__govde">
                        <p>
                            Rosso Lounge Bistro, Marmara'nın kıyısında bir akşamın nasıl
                            geçmesi gerektiğine dair sessiz bir iddiadır. Burada tabak,
                            sohbetin önüne geçmez; onu tamamlar.
                        </p>
                        <p>
                            Sebzeler her sabah yerel üreticiden gelir, ateş gün boyu
                            yanar, ışık akşama doğru yavaşça alçalır. Aceleye yer yoktur —
                            ne mutfakta, ne masada.
                        </p>
                    </div>

                    <dl class="hakkinda__olcut">
                        <div>
                            <dt>@(ViewBag.ToplamUrun ?? 0)</dt>
                            <dd>menüde lezzet</dd>
                        </div>
                        <div>
                            <dt>@(ViewBag.OrtalamaPuan ?? "—")</dt>
                            <dd>misafir puanı</dd>
                        </div>
                        <div>
                            <dt>12.5</dt>
                            <dd>saat kesintisiz servis</dd>
                        </div>
                    </dl>
                </div>
            </div>

            @* --- İmza alıntısı --- *@
            <figure class="hakkinda__alinti">
                <blockquote>
                    <p>Bir masa, sadece yemek yenen yer değildir; akşamın nerede başladığıdır.</p>
                </blockquote>
                <figcaption>Rosso Lounge Bistro — Bandırma</figcaption>
            </figure>
        </section>

        @* ============================================================
           VİTRİN — ana sayfada yalnızca seçilmiş birkaç tabak.
           Tam menü /menu sayfasında; ana sayfa bitmez bir listeye
           dönüşmesin diye burada sadece 3 ürün gösteriliyor.
           Seçim panelden yönetiliyor: SiraNo'su en küçük 3 ürün gelir.
           Razor notu: Views/Home/_Vitrin.cshtml partial'ına taşınabilir.
           ============================================================ *@
        @{
            var vitrin = ViewBag.OneCikanlar as List<RossoLoungeWeb.Models.Urun>
                         ?? new List<RossoLoungeWeb.Models.Urun>();
            var vitrinYedek = "/img/site/sunum.jpg";
        }

        <section id="menu" class="vitrin">
            <div class="kap">
                <header class="vitrin__bas">
                    <p class="vitrin__ustbaslik">Mutfaktan</p>
                    <h2 class="vitrin__baslik">Bu haftanın <em>seçkileri</em></h2>
                    <p class="vitrin__alt">
                        Şefimizin öne çıkardığı birkaç tabak. Menünün tamamı için sayfayı ziyaret edin.
                    </p>
                </header>

                @if (vitrin.Count > 0)
                {
                    <div class="vitrin__izgara">
                        @foreach (var urun in vitrin)
                        {
                            <article class="vitrin__kart">
                                <div class="vitrin__gorsel">
                                    <img src="@(string.IsNullOrEmpty(urun.ResimUrl) || urun.ResimUrl.StartsWith("http") ? vitrinYedek : urun.ResimUrl)"
                                         alt="@urun.Ad" loading="lazy" width="800" height="1000">
                                </div>

                                <div class="vitrin__govde">
                                    <h3 class="vitrin__ad">@urun.Ad</h3>
                                    @if (!string.IsNullOrWhiteSpace(urun.Aciklama))
                                    {
                                        <p class="vitrin__aciklama">@urun.Aciklama</p>
                                    }
                                    @* İki fiyat varken hangisinin ne olduğu yazmalı;
                                       menü sayfasındaki gösterimle aynı dil. *@
                                    <p class="vitrin__fiyat">
                                        @if (urun.FiyatBuyuk.HasValue)
                                        {
                                            <span class="vitrin__olcu">
                                                <span class="vitrin__olcu-ad">@(string.IsNullOrEmpty(urun.FiyatTur) ? "Orta" : urun.FiyatTur)</span>
                                                @urun.Fiyat.ToString("N0")<span class="vitrin__para">₺</span>
                                            </span>
                                            <span class="vitrin__olcu">
                                                <span class="vitrin__olcu-ad">@(string.IsNullOrEmpty(urun.FiyatBuyukTur) ? "Büyük" : urun.FiyatBuyukTur)</span>
                                                @urun.FiyatBuyuk.Value.ToString("N0")<span class="vitrin__para">₺</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="vitrin__olcu">
                                                @urun.Fiyat.ToString("N0")<span class="vitrin__para">₺</span>
                                            </span>
                                        }
                                    </p>
                                </div>
                            </article>
                        }
                    </div>

                    <div class="vitrin__eylem">
                        <a href="/menu" class="btn btn--sampanya">Tüm Menüyü Gör</a>
                        <p class="vitrin__ipucu">@(ViewBag.ToplamUrun ?? 0) tabak, @(ViewBag.KategoriSayisi ?? 0) kategori</p>
                    </div>
                }
                else
                {
                    <p class="vitrin__bos">Menü yakında burada olacak.</p>
                }
            </div>
        </section>

        @* =========================================================
           GALERİ SERGİSİ
           Dikey kaydırma bu bölümde yatay akışa dönüşür (GSAP ScrollTrigger
           pin). JS/GSAP yoksa .galeri--pinli sınıfı hiç eklenmez ve ray
           doğal bir yatay kaydırıcı olarak kalır — içerik her koşulda erişilir.
           ========================================================= *@
        <section id="galeri" class="galeri" aria-labelledby="galeri-baslik">
            <div class="galeri__sahne">
                <div class="galeri__ray">
                    <header class="galeri__giris">
                        <p class="galeri__ustbaslik">Galeri</p>
                        <h2 class="galeri__baslik" id="galeri-baslik">Mekân &amp; <em>Atmosfer</em></h2>
                        <p class="galeri__alt">Işığı, masaları ve deniz terasıyla sizi bekleyen ortamdan kareler. Kaydırdıkça sergi yanınızdan akar.</p>
                        <p class="galeri__ipucu">
                            <span class="galeri__ipucu-cizgi" aria-hidden="true"></span>
                            Kaydırarak gezin
                        </p>
                    </header>

@{ var galeriSira = 0; }
@foreach (var kare in galeriKareleri)
{
    galeriSira++;
                    <button type="button"
                            class="galeri__kare@(kare.Genis ? " galeri__kare--genis" : "")"
                            data-galeri-no="@galeriSira.ToString("00")"
                            data-galeri-etiket="@kare.Etiket"
                            data-cursor-text="Keşfet"
                            aria-label="Tam ekranda aç: @kare.Etiket">
                        <span class="galeri__cerceve">
                            <img class="galeri__foto" src="@kare.Gorsel" alt="@kare.Alt" loading="lazy" draggable="false">
                        </span>
                        <span class="galeri__ayak">
                            <span class="galeri__no">@galeriSira.ToString("00")</span>
                            <span class="galeri__etiket">@kare.Etiket</span>
                        </span>
                    </button>
}
                </div>

                <div class="galeri__ilerleme" aria-hidden="true">
                    <span class="galeri__ilerleme-dolgu"></span>
                </div>
            </div>
        </section>

        @* =========================================================
           ZİYARETÇİ DEFTERİ
           Karusel değil: tek yorum ekranın merkezinde, tipografi odaklı.
           Yapraklar @foreach ile üretiliyor — kaynak Model'deki onaylı
           yorum listesi, blok başka hiçbir şeye bağlı değil.

           JS devralmazsa (.defter--sahnede yoksa) yapraklar alt alta
           okunur bir liste olarak kalır; sürükleme/ilerleme gizlenir.
           ========================================================= *@
        <section id="yorumlar" class="defter" aria-labelledby="defter-baslik">
            <div class="kap">
                <header class="defter__bas">
                    <p class="defter__ustbaslik">Misafirlerimiz</p>
                    <h2 class="defter__baslik" id="defter-baslik">Ziyaretçi <em>Defteri</em></h2>
                    <p class="defter__alt">Yorumlar onaylandıktan sonra yayınlanır; hepsi gerçek misafirlerimizden.</p>
                </header>
            </div>

            @if (yorumlar.Count > 0)
            {
                <div class="defter__sergi">
                    <div class="defter__sahne kap" role="group"
                         aria-roledescription="yorum sergisi" aria-label="Misafir yorumları"
                         tabindex="0">
@{ var yorumSira = 0; }
@foreach (var y in yorumlar)
{
    yorumSira++;
    // Yorum uzunlukları çok değişken; tek bir dev punto uzun metinde
    // ekranı taşırıyor. Punto metnin uzunluğuna göre kademeleniyor.
    var uzunluk = (y.Mesaj ?? string.Empty).Length;
    var boyut = uzunluk <= 130 ? "defter__soz--dev"
              : uzunluk <= 320 ? "defter__soz--orta"
                               : "defter__soz--sik";
                        <article class="defter__yaprak" data-defter-sira="@yorumSira">
                            <p class="defter__isaret" aria-hidden="true">&ldquo;</p>

                            <blockquote class="defter__soz @boyut">
                                <p class="defter__metin">@y.Mesaj</p>
                            </blockquote>

                            <footer class="defter__imza">
                                <p class="defter__ad">@y.AdSoyad</p>
                                <p class="defter__ayrinti">
                                    <span class="defter__puan" role="img" aria-label="5 üzerinden @y.Puan puan">
                                        @for (int p = 1; p <= 5; p++)
                                        {
                                            <span class="defter__cizik@(p <= y.Puan ? " defter__cizik--dolu" : "")" aria-hidden="true"></span>
                                        }
                                    </span>
                                    <span class="defter__tarih">@y.Tarih.ToString("MMMM yyyy", tr)</span>
                                </p>
                            </footer>
                        </article>
}
                    </div>

                    @if (yorumlar.Count > 1)
                    {
                        @* Kenar bölgeleri: masaüstünde görünmez, imleç üstlerine
                           gelince sıvı imleç "Geri/İleri" etiketine dönüşüyor.
                           Gerçek <button> oldukları için klavye ve dokunmatik
                           kullanıcıları da geçiş yapabiliyor. *@
                        <button type="button" class="defter__yon defter__yon--geri" aria-label="Önceki yorum">
                            <span class="defter__yon-yazi" aria-hidden="true">Geri</span>
                        </button>
                        <button type="button" class="defter__yon defter__yon--ileri" aria-label="Sonraki yorum">
                            <span class="defter__yon-yazi" aria-hidden="true">İleri</span>
                        </button>
                    }
                </div>

                @if (yorumlar.Count > 1)
                {
                    <div class="kap">
                        <div class="defter__ayak">
                            <p class="defter__sayac">
                                <span class="defter__su" aria-live="polite">01</span>
                                <span class="defter__bolu" aria-hidden="true">/</span>
                                <span class="defter__toplam">@yorumlar.Count.ToString("00")</span>
                            </p>
                            <div class="defter__ilerleme" aria-hidden="true">
                                <span class="defter__ilerleme-dolgu"></span>
                            </div>
                            <p class="defter__ipucu" aria-hidden="true">Sürükleyin</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="kap">
                    <div class="defter__bos">
                        <p class="defter__isaret" aria-hidden="true">&ldquo;</p>
                        <p class="defter__bos-baslik">Defter henüz boş</p>
                        <p class="defter__bos-alt">İlk satırı siz yazın — deneyiminiz bizden sonra gelecek misafirlere yol gösterir.</p>
                    </div>
                </div>
            }

            <div class="kap">
                @* ---- Çağrı: formu açan tek satırlık minimal buton ----
                   JS yoksa gizli kalır, çünkü o durumda panel zaten
                   akışın içinde açık duruyor. *@
                <p class="paylas-cagri">
                    <button type="button" class="paylas-ac" id="paylas-ac" aria-haspopup="dialog" hidden>
                        <span class="paylas-ac__yazi">Deneyiminizi paylaşın</span>
                        <span class="paylas-ac__cizgi" aria-hidden="true"></span>
                    </button>
                </p>
            </div>

        </section>

        @* =========================================================
           KONSİYER — iletişim
           Asimetrik bölünme: solda devasa başlık + mekân bilgileri,
           sağda form. Bilgi satırları kaydırmada maskeyle sırayla
           beliriyor (.kn-maske, yalnızca html.rosso-kinetik altında
           gizli — GSAP düşerse hepsi açık gelir).

           İKİ FORM KORUNDU: rezervasyon ve mesaj sekmeli panelde.
           Sunucu tarafı değişmedi — action, name'ler, token, id'ler
           (#reservation-form, #datePicker, #phoneInput) aynı.
           ========================================================= *@
        <section id="iletisim" class="konsiyer" aria-labelledby="konsiyer-baslik">
            <div class="kap konsiyer__izgara">

                <div class="konsiyer__sol" data-ritim-sahibi>
                    <p class="konsiyer__ustbaslik kn-maske">İletişim</p>
                    <h2 class="konsiyer__baslik" id="konsiyer-baslik" data-kelime-acilis>Bize <em>Ulaşın</em></h2>
                    <p class="konsiyer__alt kn-maske">Masanızı ayırtın ya da aklınıza takılanı sorun — aynı gün dönüş yapıyoruz.</p>

                    <dl class="konsiyer__bilgi">
                        <div class="konsiyer__satir kn-maske">
                            <dt class="konsiyer__etiket">Adres</dt>
                            <dd class="konsiyer__deger">
                                @* Ayrı "Yol tarifi al" butonu yerine adresin kendisi
                                   bağlantı; aynı yere gidiyor. *@
                                <a class="konsiyer__adres" target="_blank" rel="noopener"
                                   href="https://www.google.com/maps/dir/?api=1&amp;destination=Rosso+lounge+bistro+Bandırma"
                                   aria-label="Yol tarifi al: Yeni Mahalle, 21002 Sokak No: 3B, Bandırma">
                                    Yeni Mahalle, 21002 Sokak No: 3B<br>
                                    10200 Bandırma / Balıkesir
                                </a>
                            </dd>
                        </div>

                        <div class="konsiyer__satir kn-maske">
                            <dt class="konsiyer__etiket">Rezervasyon hattı</dt>
                            <dd class="konsiyer__deger">
                                <a class="konsiyer__telefon" href="tel:+902667121313">+90 266 712 13 13</a>
                            </dd>
                        </div>

                        <div class="konsiyer__satir kn-maske">
                            <dt class="konsiyer__etiket">Çalışma saatleri</dt>
                            <dd class="konsiyer__deger">
                                Her gün 11.30 – 00.00
                            </dd>
                        </div>

                        <div class="konsiyer__satir kn-maske">
                            <dt class="konsiyer__etiket">E-posta</dt>
                            <dd class="konsiyer__deger">
                                <a href="mailto:info@@rossolounge.com">info@@rossolounge.com</a>
                            </dd>
                        </div>
                    </dl>

                    @* Canlı saat + durum ışığı.
                       Sunucu Türkiye saatiyle ilk değeri basıyor, böylece JS
                       çalışmasa da doğru görünüyor. script.js aynı data-*
                       niteliklerini okuyup Europe/Istanbul saatiyle her dakika
                       tazeliyor — ziyaretçinin saat dilimi ne olursa olsun
                       mekânın saati gösteriliyor. *@
                    <div class="saat-isik saat-isik--@ViewBag.SaatDurum kn-maske"
                         data-acilis="@ViewBag.Acilis" data-kapanis="@ViewBag.Kapanis"
                         data-mola-bas="@ViewBag.MolaBas" data-mola-bit="@ViewBag.MolaBit">
                        <span class="saat-isik__nokta" aria-hidden="true"></span>
                        <time class="saat-isik__saat">@ViewBag.SaatSimdi</time>
                        <span class="saat-isik__metin">
                            @(ViewBag.SaatDurum switch { "acik" => "Şu an açık", "mola" => "Molada", _ => "Şu an kapalı" })
                        </span>
                    </div>

                    @* Monokrom harita: renkli gömülü harita koyu dili bozuyordu.
                       Filtre + obsidyen perde ile sahneye uyduruldu; perde
                       üstüne gelince/odaklanınca açılıyor. *@
                    <figure class="harita kn-maske">
                        <iframe class="harita__cerceve" title="Rosso Lounge Bistro konumu"
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d319.6543230992864!2d27.936944127683113!3d40.34053662812616!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14b5d3bd385d1797%3A0x887916a4f8a71e73!2sRosso%20lounge%20bistro!5e0!3m2!1str!2str!4v1763491907694!5m2!1str!2str"
                                loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                        <figcaption class="harita__perde">
                            <span class="harita__yer">Bandırma · Marmara kıyısı</span>
                            <span class="harita__ipucu">Kullanmak için tıklayın</span>
                        </figcaption>
                    </figure>

                    <div class="sosyal-satir konsiyer__sosyal kn-maske">
                        <a href="https://www.instagram.com/rosso.lounge.bistro/" target="_blank" rel="noopener" aria-label="Instagram sayfamız">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
                        </a>
                        <a href="https://www.facebook.com/rossolounge" target="_blank" rel="noopener" aria-label="Facebook sayfamız">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6c-.3-.04-1.3-.13-2.47-.13-2.44 0-4.11 1.49-4.11 4.23V9.9H7.4V13h2.72v8Z"/></svg>
                        </a>
                    </div>
                </div>

                <div class="konsiyer__sag">
                    <div class="form-panel" id="rezervasyon">
                        <div class="form-sekmeler" role="tablist" aria-label="İletişim biçimi">
                            <button type="button" class="form-sekme aktif" role="tab" id="sekme-rezervasyon"
                                    aria-selected="true" aria-controls="panel-rezervasyon">
                                Masa Ayırt
                            </button>
                            <button type="button" class="form-sekme" role="tab" id="sekme-mesaj"
                                    aria-selected="false" aria-controls="panel-mesaj" tabindex="-1">
                                Mesaj Gönder
                            </button>
                        </div>

                        <div class="form-govde" role="tabpanel" id="panel-rezervasyon" aria-labelledby="sekme-rezervasyon" tabindex="0">
                            <p class="konsiyer__form-alt">Özel günleriniz veya akşam yemeğiniz için yerinizi şimdiden ayırtın.</p>

                            <form id="reservation-form" class="konsiyer__form" method="post" action="/Home/RezervasyonYap">
                                @Html.AntiForgeryToken()

                                <div class="alan">
                                    <input class="alan__girdi" type="text" id="rez-ad" name="AdSoyad"
                                           placeholder=" " autocomplete="name" maxlength="100" required>
                                    <label class="alan__etiket" for="rez-ad">Ad Soyad</label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                </div>

                                <div class="alan">
                                    <input class="alan__girdi" type="tel" id="phoneInput" name="Telefon"
                                           placeholder=" " autocomplete="tel" inputmode="numeric" maxlength="10"
                                           aria-describedby="telefon-yardim" required>
                                    <label class="alan__etiket" for="phoneInput">Telefon</label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                    <small class="alan__yardim" id="telefon-yardim">Başında sıfır olmadan 10 hane</small>
                                </div>

                                <div class="alan">
                                    <input class="alan__girdi" type="text" id="datePicker" name="Tarih"
                                           placeholder=" " required>
                                    <label class="alan__etiket" for="datePicker">Tarih ve Saat</label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                </div>

                                <div class="alan">
                                    <input class="alan__girdi" type="number" id="rez-kisi" name="KisiSayisi"
                                           placeholder=" " min="1" max="100" required>
                                    <label class="alan__etiket" for="rez-kisi">Kişi Sayısı</label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                </div>

                                <div class="alan alan--tam alan--govde">
                                    <textarea class="alan__girdi" id="rez-not" name="Not" rows="3"
                                              placeholder=" " maxlength="500"></textarea>
                                    <label class="alan__etiket" for="rez-not">Özel notunuz <span class="alan__istege-bagli">(opsiyonel)</span></label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                </div>

                                <button type="submit" class="konsiyer__gonder alan--tam">Rezervasyonu Tamamla</button>
                            </form>
                        </div>

                        <div class="form-govde" role="tabpanel" id="panel-mesaj" aria-labelledby="sekme-mesaj" tabindex="0" hidden>
                            <p class="konsiyer__form-alt">Soru, öneri veya özel organizasyon talepleriniz için yazın.</p>

                            <form class="konsiyer__form" method="post" action="/Home/IletisimGonder">
                                @Html.AntiForgeryToken()

                                <div class="alan">
                                    <input class="alan__girdi" type="text" id="iletisim-ad" name="AdSoyad"
                                           placeholder=" " autocomplete="name" maxlength="100" required>
                                    <label class="alan__etiket" for="iletisim-ad">Ad Soyad</label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                </div>

                                <div class="alan">
                                    <input class="alan__girdi" type="email" id="iletisim-eposta" name="Email"
                                           placeholder=" " autocomplete="email" maxlength="150" required>
                                    <label class="alan__etiket" for="iletisim-eposta">E-Posta</label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                </div>

                                <div class="alan alan--tam">
                                    <input class="alan__girdi" type="tel" id="iletisim-telefon" name="Telefon"
                                           placeholder=" " autocomplete="tel" maxlength="25">
                                    <label class="alan__etiket" for="iletisim-telefon">Telefon <span class="alan__istege-bagli">(opsiyonel)</span></label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                </div>

                                <div class="alan alan--tam alan--govde">
                                    <textarea class="alan__girdi" id="iletisim-mesaj" name="Mesaj" rows="5"
                                              placeholder=" " minlength="5" maxlength="2000" required></textarea>
                                    <label class="alan__etiket" for="iletisim-mesaj">Mesajınız</label>
                                    <span class="alan__cizgi" aria-hidden="true"></span>
                                </div>

                                <button type="submit" class="konsiyer__gonder alan--tam">Mesajı Gönder</button>
                            </form>
                        </div>
                    </div>

                    @* İMZA — footer'dan buraya taşındı.
                       Haritanın sağındaki boşlukta beliriyor. Dar sütun
                       olduğu için iki söz alt alta; her söz kendi içinde
                       kenardan kenara yayılıyor.
                       Ekran okuyucu harf harf okumasın diye kap gizli,
                       ad görsel-gizli metinle veriliyor. *@
                    <p class="gorsel-gizli">Rosso Lounge</p>
                    <div class="imza" id="imza" aria-hidden="true">
                        @foreach (var soz in new[] { "ROSSO", "LOUNGE" })
                        {
                            <span class="imza__soz">
                                @foreach (var harf in soz)
                                {
                                    <span class="imza__harf"><span>@harf</span></span>
                                }
                            </span>
                        }
                    </div>
                </div>
            </div>
        </section>

    </main>

@* Yorum gönderme paneli — BİLEREK <main> DIŞINDA.
   #tamekran ile aynı sebep: finale perdesi için main'e verilen
   "z-index: 1" bir yığılma bağlamı yaratıyor, panelin 9999'u o
   bağlamın İÇİNDE yorumlanıyor ve navbar (900, main'in kardeşi)
   panelin üstüne biniyordu. Ölçüldü: panelin y=30 noktasında
   REZERVASYON düğmesi, y=60'ta navbar vardı; formun üst kısmı
   navbarın altında kalıyordu.

   JS devralırsa (.paylas--katman) panel sağdan kayan bir off-canvas
   katmana dönüşür. Devralmazsa akışın içinde normal bir form olarak
   durur — hiçbir koşulda erişilmez hâle gelmez.
*@
            <div class="paylas" id="paylas">
                <div class="paylas__zemin" aria-hidden="true"></div>

                <div class="paylas__panel" id="paylas-panel" tabindex="-1" aria-labelledby="paylas-baslik">
                    <button type="button" class="paylas__kapat" aria-label="Formu kapat" hidden>
                        <span aria-hidden="true">&times;</span>
                    </button>

                    <p class="paylas__ustbaslik">Ziyaretçi defteri</p>
                    <h3 class="paylas__baslik" id="paylas-baslik">Deneyiminizi <em>yazın</em></h3>
                    <p class="paylas__alt">Birkaç cümle yeter. Yorumunuz onaylandıktan sonra defterde yerini alır.</p>

                    <form class="paylas__form" method="post" action="/Home/YorumYap">
                        @Html.AntiForgeryToken()

                        @* placeholder=" " şart: yüzen etiket :placeholder-shown
                           ile "alan boş mu" sorusunu yanıtlıyor. Etiket girdiden
                           SONRA geliyor ki + kardeş seçicisi çalışsın. *@
                        <div class="alan">
                            <input class="alan__girdi" type="text" id="paylas-ad" name="AdSoyad"
                                   placeholder=" " autocomplete="name" maxlength="100" required>
                            <label class="alan__etiket" for="paylas-ad">Ad Soyad</label>
                            <span class="alan__cizgi" aria-hidden="true"></span>
                        </div>

                        @* Puan: 5→1 sırasıyla yazılıp CSS'te row-reverse ile
                           çevriliyor. Böylece "seçilen ve altındakiler dolu"
                           kuralı ~ kardeş seçicisiyle JS'siz çalışıyor. *@
                        <fieldset class="puan">
                            <legend class="puan__baslik">Puanınız</legend>

                            <div class="puan__sira">
                                @for (int p = 5; p >= 1; p--)
                                {
                                    <input class="puan__radyo" type="radio" name="Puan"
                                           id="paylas-puan-@p" value="@p" required>
                                    <label class="puan__isaret" for="paylas-puan-@p">
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path d="M12 1.8 22.2 12 12 22.2 1.8 12Z" />
                                        </svg>
                                        <span class="gorsel-gizli">@p puan</span>
                                    </label>
                                }
                            </div>

                            <p class="puan__yazi" aria-live="polite"></p>
                        </fieldset>

                        <div class="alan alan--govde">
                            <textarea class="alan__girdi" id="paylas-mesaj" name="Mesaj" rows="4"
                                      placeholder=" " maxlength="1000" required></textarea>
                            <label class="alan__etiket" for="paylas-mesaj">Yorumunuz</label>
                            <span class="alan__cizgi" aria-hidden="true"></span>
                            <span class="alan__sayac" aria-hidden="true"></span>
                        </div>

                        <button type="submit" class="paylas__gonder">Yorumu Gönder</button>
                    </form>
                </div>
            </div>

@* Tam ekran görüntüleyici — çerçeve, tıklanan karenin üstünden GSAP ile büyür.

   BİLEREK <main> DIŞINDA: finale perdesi için main'e
   "position: relative; z-index: 1" veriliyor ve bu bir yığılma bağlamı
   yaratıyor. Katman main içinde kalırsa z-index: 9999 o bağlamın İÇİNDE
   yorumlanıyor, navbar (z-index: 900, main'in kardeşi) fotoğrafın üstüne
   biniyor: kapatma düğmesi görünmez oluyor ve tıklamalar navbara gidip
   sayfayı başka bölüme atıyor. Ölçüldü ve ekran görüntüsüyle doğrulandı.
*@
        <div class="tamekran" id="tamekran" role="dialog" aria-modal="true" aria-label="Görsel önizleme" hidden>
            <div class="tamekran__zemin"></div>

            <div class="tamekran__cerceve">
                <img class="tamekran__foto" src="" alt="">
            </div>

            <div class="tamekran__ayak">
                <span class="tamekran__no"></span>
                <span class="tamekran__etiket"></span>
            </div>

            <button type="button" class="tamekran__kapat" aria-label="Kapat">
                <span aria-hidden="true">&times;</span>
            </button>
            <button type="button" class="tamekran__ok tamekran__ok--onceki" aria-label="Önceki görsel">
                <span aria-hidden="true">&#10094;</span>
            </button>
            <button type="button" class="tamekran__ok tamekran__ok--sonraki" aria-label="Sonraki görsel">
                <span aria-hidden="true">&#10095;</span>
            </button>
        </div>

    @* Footer artık yalnızca iki satır: telif + geliştirici imzası.
       Devasa ROSSO LOUNGE yazısı iletişim bölümüne, haritanın sağına
       taşındı. Bu yüzden eski "sabit footer perdesi" (fixed konum +
       .finale-bosluk yer ayırma) kaldırıldı — iki satır için gereksizdi
       ve main'e verdiği z-index bağlamı katmanları hapsediyordu. *@
    <footer class="finale" id="finale">
        <div class="kap finale__ic">


            <div class="finale__alt">
                <p class="finale__telif">&copy; @yil Rosso Lounge Bistro</p>

                <div class="footer-signature">Software &amp; Design by <span class="developer-name">Mert CEREN</span></div>
            </div>
        </div>
    </footer>

@section Scriptler {
    @* Yalnızca rezervasyon formunun tarih seçicisi için *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script defer src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>
}
