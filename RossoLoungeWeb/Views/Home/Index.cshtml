@model List<RossoLoungeWeb.Models.Yorum>
@{
    Layout = null;

    // Öne çıkan ürünler HomeController.Index'ten geliyor (SiraNo'ya göre ilk 3).
    var oneCikanlar = ViewBag.OneCikanlar as List<RossoLoungeWeb.Models.Urun> ?? new List<RossoLoungeWeb.Models.Urun>();
    var yorumlar = Model ?? new List<RossoLoungeWeb.Models.Yorum>();

    // Kültür Program.cs'te InvariantCulture'a sabitlendi (form verisi için).
    // Ekranda gösterilen fiyat/tarih Türkçe olsun diye kültürü açıkça belirtiyoruz.
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var yil = RossoLoungeWeb.Services.TurkiyeSaati.Simdi.Year;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rosso Lounge Bistro | Bandırma</title>
    <meta name="description" content="Rosso Lounge Bistro — Bandırma'da modern atmosfer, taze lezzetler ve imza kokteyller. Online masa rezervasyonu yapın.">
    <link rel="icon" href="~/favicon.jpg" type="image/jpeg">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    @* Yeni sahne mimarisi en sonda: eski katmanı bilinçli olarak ezer *@
    <link rel="stylesheet" href="~/css/rosso-tema.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/rosso-bilesenler.css" asp-append-version="true">

    <style>
        /* SADECE bu sayfaya (ve Menu.cshtml'e) özgü kurallar.
           style.css'te karşılığı olan .menu-card / .menu-info / .price / .menu-header
           kuralları silindi — tek kaynak style.css.
           Aşağıdakiler style.css'te YOK; Tasarım ajanına taşınması için bildirildi. */
        .menu-item {
            display: flex;
            flex-direction: column;
        }

        /* Ürünün görseli yoksa zarif yer tutucu */
        .gorsel-yok {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 200px;
            background: var(--yz-zemin-vurgu);
            color: var(--renk-marka);
            font-size: var(--olcek-3xl);
            opacity: 0.55;
        }

        .menu-info {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

            .menu-info h3 {
                margin-top: 0;
            }

            .menu-info p {
                margin: 0 0 var(--bosluk-4);
            }

        /* Tek ya da çift fiyat satırı (Orta / Büyük) */
        .fiyat-satiri {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: baseline;
            gap: var(--bosluk-4);
            margin-top: auto;
            padding-top: var(--bosluk-3);
            border-top: 1px solid var(--yz-kenar);
        }

        .fiyat-secenek {
            min-width: 0;
        }

        .fiyat-etiket {
            display: block;
            color: var(--yz-metin-soluk);
            font-size: var(--olcek-xs);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .fiyat-satiri .price {
            margin-top: 0;
        }
    </style>
</head>

<body>
    @* ---- Sinematik perde: sayaç dolar, ardından iki panel yırtılır ---- *@
    <div class="sahne-perde" aria-hidden="true">
        <div class="sahne-perde__marka">ROSSO <span>LOUNGE</span></div>
        <div class="sahne-perde__sayac">000</div>
    </div>
    <div class="sahne-perde__panel sahne-perde__panel--ust" aria-hidden="true"></div>
    <div class="sahne-perde__panel sahne-perde__panel--alt" aria-hidden="true"></div>

    @* ---- Sıvı imleç (yalnızca fare olan cihazlarda görünür) ---- *@
    <div class="imlec" aria-hidden="true">
        <span class="imlec__halka"></span>
        <span class="imlec__nokta"></span>
    </div>

    <a href="#icerik" class="atla">İçeriğe atla</a>
    <div class="nav-perde" aria-hidden="true"></div>

    <header class="nav" id="navbar">
        <div class="kap nav__ic">
            <a href="#home" class="nav__marka">ROSSO <span>LOUNGE</span></a>

            <nav aria-label="Ana menü">
                <ul class="nav__menu">
                    <li><a href="#home" class="nav__link nav__link--aktif">Ana Sayfa</a></li>
                    <li><a href="#about" class="nav__link">Hakkımızda</a></li>
                    <li><a href="/Home/Menu" class="nav__link">Menü</a></li>
                    <li><a href="#gallery" class="nav__link">Galeri</a></li>
                    <li><a href="#reviews" class="nav__link">Yorumlar</a></li>
                    <li><a href="#contact" class="nav__link">İletişim</a></li>
                    <li class="nav__mobil"><a href="#rezervasyon" class="nav__eylem">Rezervasyon</a></li>
                </ul>
            </nav>

            <a href="#rezervasyon" class="nav__eylem nav__eylem--masaustu">Rezervasyon</a>

            <button type="button" class="nav__hamburger" aria-label="Menüyü aç veya kapat" aria-expanded="false">
                <span class="nav__cizgi"></span>
            </button>
        </div>
    </header>

    <main id="icerik">
        <section id="home" class="hero">
            <div class="hero__zemin" aria-hidden="true"></div>
            <div class="hero__perde" aria-hidden="true"></div>

            <div class="hero__ic">
                <p class="hero__ustbaslik">Bandırma · Marmara kıyısında</p>

                <h1 class="hero__baslik">
                    Lezzetin ve konforun
                    <em>buluşma noktası</em>
                </h1>

                <p class="hero__alt">
                    Sıcak bir ışık, iyi bir sohbet ve hak ettiği tabaklar.
                </p>

                <div class="hero__eylemler">
                    <a href="#rezervasyon" class="btn btn--sampanya">Masa Ayırt</a>
                    <a href="/Home/Menu" class="btn btn--hat">Menüyü Keşfet</a>
                </div>

                @if (ViewBag.SuAnAcik is bool heroAcik)
                {
                    <p class="hero__durum">
                        <span class="rozet @(heroAcik ? "rozet--acik" : "rozet--kapali")">
                            <span class="rozet__nokta" aria-hidden="true"></span>
                            @(heroAcik ? "Şu an açığız" : "Şu an kapalıyız")
                        </span>
                        <span class="hero__saat">Her gün 11.30 – 00.00</span>
                    </p>
                }
            </div>

            <a href="#about" class="hero__kaydir" aria-label="Aşağı kaydır"></a>
        </section>

        @* ============================================================
           HAKKIMIZDA
           Razor notu: bu blok olduğu gibi Views/Home/_Hakkinda.cshtml
           dosyasına taşınabilir ve Index'ten
           @await Html.PartialAsync("_Hakkinda") ile çağrılabilir.
           Dışarıdan veri almıyor, bağımsız bir partial.
           ============================================================ *@
        <section id="about" class="hakkinda">
            <div class="kap hakkinda__izgara">

                @* --- Asimetrik görsel kompozisyon: iki çerçeve hafifçe binişik --- *@
                <div class="hakkinda__gorseller">
                    <figure class="hakkinda__cerceve hakkinda__cerceve--genis" data-parallax="-14">
                        <img class="hakkinda__foto"
                             src="/img/site/aksam-masa.jpg"
                             alt="Akşam ışığında hazırlanmış masa, kadehler ve tabaklar"
                             loading="eager" decoding="async" width="1800" height="1200">
                    </figure>

                    <figure class="hakkinda__cerceve hakkinda__cerceve--dar" data-parallax="16">
                        <img class="hakkinda__foto"
                             src="/img/site/sef.jpg"
                             alt="Şefimiz servis öncesi malzemeleri hazırlarken"
                             loading="lazy" width="1200" height="1800">
                    </figure>

                    <span class="hakkinda__yil" aria-hidden="true">
                        <em>2019</em>
                        <span>o günden beri</span>
                    </span>
                </div>

                @* --- Metin --- *@
                <div class="hakkinda__metin">
                    <p class="hakkinda__ustbaslik">Hakkımızda</p>

                    <h2 class="hakkinda__baslik" data-kelime-acilis>
                        Sıradanlığın ötesinde <em>bir gastronomi</em>
                    </h2>

                    <div class="hakkinda__govde">
                        <p>
                            Rosso Lounge Bistro, Marmara'nın kıyısında bir akşamın nasıl
                            geçmesi gerektiğine dair sessiz bir iddiadır. Burada tabak,
                            sohbetin önüne geçmez; onu tamamlar.
                        </p>
                        <p>
                            Sebzeler her sabah yerel üreticiden gelir, ateş gün boyu
                            yanar, ışık akşama doğru yavaşça alçalır. Aceleye yer yoktur —
                            ne mutfakta, ne masada.
                        </p>
                    </div>

                    <dl class="hakkinda__olcut">
                        <div>
                            <dt>@(ViewBag.ToplamUrun ?? 0)</dt>
                            <dd>menüde lezzet</dd>
                        </div>
                        <div>
                            <dt>@(ViewBag.OrtalamaPuan ?? "—")</dt>
                            <dd>misafir puanı</dd>
                        </div>
                        <div>
                            <dt>12.5</dt>
                            <dd>saat kesintisiz servis</dd>
                        </div>
                    </dl>

                    <div class="hakkinda__eylemler">
                        <a href="/Home/Menu" class="btn btn--hat">Menüyü İncele</a>
                    </div>
                </div>
            </div>

            @* --- İmza alıntısı --- *@
            <figure class="hakkinda__alinti">
                <blockquote>
                    <p>Bir masa, sadece yemek yenen yer değildir; akşamın nerede başladığıdır.</p>
                </blockquote>
                <figcaption>Rosso Lounge Bistro — Bandırma</figcaption>
            </figure>
        </section>

        @* ============================================================
           VİTRİN — ana sayfada yalnızca seçilmiş birkaç tabak.
           Tam menü /Home/Menu sayfasında; ana sayfa bitmez bir listeye
           dönüşmesin diye burada sadece 3 ürün gösteriliyor.
           Seçim panelden yönetiliyor: SiraNo'su en küçük 3 ürün gelir.
           Razor notu: Views/Home/_Vitrin.cshtml partial'ına taşınabilir.
           ============================================================ *@
        @{
            var vitrin = ViewBag.OneCikanlar as List<RossoLoungeWeb.Models.Urun>
                         ?? new List<RossoLoungeWeb.Models.Urun>();
            var vitrinYedek = "/img/site/sunum.jpg";
        }

        <section id="menu" class="vitrin">
            <div class="kap">
                <header class="vitrin__bas">
                    <p class="vitrin__ustbaslik">Mutfaktan</p>
                    <h2 class="vitrin__baslik">Bu haftanın <em>seçkileri</em></h2>
                    <p class="vitrin__alt">
                        Şefimizin öne çıkardığı birkaç tabak. Menünün tamamı için sayfayı ziyaret edin.
                    </p>
                </header>

                @if (vitrin.Count > 0)
                {
                    <div class="vitrin__izgara">
                        @foreach (var urun in vitrin)
                        {
                            <article class="vitrin__kart">
                                <div class="vitrin__gorsel">
                                    <img src="@(string.IsNullOrEmpty(urun.ResimUrl) || urun.ResimUrl.StartsWith("http") ? vitrinYedek : urun.ResimUrl)"
                                         alt="@urun.Ad" loading="lazy" width="800" height="1000">
                                </div>

                                <div class="vitrin__govde">
                                    <h3 class="vitrin__ad">@urun.Ad</h3>
                                    @if (!string.IsNullOrWhiteSpace(urun.Aciklama))
                                    {
                                        <p class="vitrin__aciklama">@urun.Aciklama</p>
                                    }
                                    <p class="vitrin__fiyat">
                                        @if (urun.FiyatBuyuk.HasValue)
                                        {
                                            <span>@urun.Fiyat.ToString("N0")<span class="vitrin__para">₺</span></span>
                                            <span class="vitrin__ayrac">/</span>
                                            <span>@urun.FiyatBuyuk.Value.ToString("N0")<span class="vitrin__para">₺</span></span>
                                        }
                                        else
                                        {
                                            <span>@urun.Fiyat.ToString("N0")<span class="vitrin__para">₺</span></span>
                                        }
                                    </p>
                                </div>
                            </article>
                        }
                    </div>

                    <div class="vitrin__eylem">
                        <a href="/Home/Menu" class="btn btn--sampanya">Tüm Menüyü Gör</a>
                        <p class="vitrin__ipucu">@(ViewBag.ToplamUrun ?? 0) tabak, @(ViewBag.KategoriSayisi ?? 0) kategori</p>
                    </div>
                }
                else
                {
                    <p class="vitrin__bos">Menü yakında burada olacak.</p>
                }
            </div>
        </section>

        <section id="gallery" class="section-padding">
            <div class="container">
                <div class="bolum-basi">
                    <p class="bolum-ustbaslik">Galeri</p>
                    <h2 class="section-title">Mekân &amp; Atmosfer</h2>
                    <p class="bolum-alt-metin">Işığı, masaları ve deniz terasıyla sizi bekleyen ortamdan birkaç kare.</p>
                </div>

                <div class="mozaik">
                    <button type="button" class="mozaik-kare kare-genis" data-buyuk="/img/site/ic-mekan.jpg" aria-label="Görseli büyüt: İç mekân">
                        <img src="/img/site/ic-mekan.jpg" alt="Koyu ahşap ve pirinç detaylı iç mekân, hazırlanmış masalar" loading="lazy">
                        <span class="mozaik-ortu"><span class="mozaik-yazi">İç mekân</span></span>
                    </button>
                    <button type="button" class="mozaik-kare" data-buyuk="/img/site/sef.jpg" aria-label="Görseli büyüt: Mutfakta hazırlık">
                        <img src="/img/site/sef.jpg" alt="Şefimiz servis öncesi malzemeleri hazırlarken" loading="lazy">
                        <span class="mozaik-ortu"><span class="mozaik-yazi">Mutfak</span></span>
                    </button>
                    <button type="button" class="mozaik-kare" data-buyuk="/img/site/bahce.jpg" aria-label="Görseli büyüt: Deniz manzaralı teras">
                        <img src="/img/site/bahce.jpg" alt="Deniz manzaralı, tenteli açık hava terası" loading="lazy">
                        <span class="mozaik-ortu"><span class="mozaik-yazi">Deniz terası</span></span>
                    </button>
                    <button type="button" class="mozaik-kare" data-buyuk="/img/site/sunum.jpg" aria-label="Görseli büyüt: Tabak sunumu">
                        <img src="/img/site/sunum.jpg" alt="Tepeden çekilmiş, tabakta sunulan ana yemekler" loading="lazy">
                        <span class="mozaik-ortu"><span class="mozaik-yazi">Tabaklarımız</span></span>
                    </button>
                    <button type="button" class="mozaik-kare" data-buyuk="/img/site/bar.jpg" aria-label="Görseli büyüt: Bar">
                        <img src="/img/site/bar.jpg" alt="Bar tezgahı ve içki rafları" loading="lazy">
                        <span class="mozaik-ortu"><span class="mozaik-yazi">Bar</span></span>
                    </button>
                    <button type="button" class="mozaik-kare kare-genis" data-buyuk="/img/site/paylasim.jpg" aria-label="Görseli büyüt: Paylaşımlı masa">
                        <img src="/img/site/paylasim.jpg" alt="Masada paylaşılan tabaklar ve arkadaş sofrası" loading="lazy">
                        <span class="mozaik-ortu"><span class="mozaik-yazi">Paylaşmak</span></span>
                    </button>
                </div>
            </div>
        </section>

        <div class="buyutec" id="buyutec" role="dialog" aria-modal="true" aria-label="Görsel önizleme" hidden>
            <button type="button" class="buyutec-kapat" aria-label="Kapat">&times;</button>
            <button type="button" class="buyutec-ok buyutec-onceki" aria-label="Önceki görsel">&#10094;</button>
            <img class="buyutec-gorsel" src="" alt="">
            <button type="button" class="buyutec-ok buyutec-sonraki" aria-label="Sonraki görsel">&#10095;</button>
        </div>

        <section id="reviews" class="section-padding bg-dark">
            <div class="container">
                <div class="bolum-basi">
                    <p class="bolum-ustbaslik">Misafirlerimiz</p>
                    <h2 class="section-title text-light">Bizim İçin Ne Dediler?</h2>
                    <p class="bolum-alt-metin">Yorumlar onaylandıktan sonra yayınlanır; hepsi gerçek misafirlerimizden.</p>
                </div>

                @if (yorumlar.Count > 0)
                {
                    <div id="reviewsCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < yorumlar.Count; i += 2)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <div class="row justify-content-center">
                                        @for (int j = 0; j < 2 && i + j < yorumlar.Count; j++)
                                        {
                                            var y = yorumlar[i + j];
                                            <div class="col-md-5 col-12 mb-3">
                                                <blockquote class="review-card">
                                                    <div class="stars" role="img" aria-label="5 üzerinden @y.Puan puan">
                                                        @for (int s = 0; s < y.Puan; s++)
                                                        {
                                                            <i class="fas fa-star" aria-hidden="true"></i>
                                                        }
                                                    </div>
                                                    <p>@y.Mesaj</p>
                                                    <div class="review-info">
                                                        <h5>@y.AdSoyad</h5>
                                                        <small>@y.Tarih.ToString("dd.MM.yyyy", tr)</small>
                                                    </div>
                                                </blockquote>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @if (yorumlar.Count > 2)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#reviewsCarousel" data-bs-slide="prev" aria-label="Önceki yorumlar">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#reviewsCarousel" data-bs-slide="next" aria-label="Sonraki yorumlar">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="rs-bos-durum mb-5">
                        <i class="fas fa-comments" aria-hidden="true"></i>
                        <h3>Henüz yorum yok</h3>
                        <p>İlk yorumu siz yapın — deneyiminiz bizden sonra gelecek misafirlere yol gösterir.</p>
                    </div>
                }

                <div class="review-form-container" id="yorum-formu">
                    <button type="button" class="yorum-ac" aria-expanded="false" aria-controls="yorum-govde">
                        <span>
                            <strong>Deneyiminizi paylaşın</strong>
                            <small>Görüşleriniz bizim için değerli — onaylandıktan sonra yayınlanır.</small>
                        </span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="yorum-govde" id="yorum-govde" hidden>
                    <form class="reservation-form-horizontal" method="post" action="/Home/YorumYap">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label for="yorum-ad">Ad Soyad <span class="rs-vurgu" aria-hidden="true">*</span></label>
                            <input type="text" id="yorum-ad" name="AdSoyad" placeholder="Adınız ve soyadınız"
                                   autocomplete="name" maxlength="100" required>
                        </div>
                        <div class="form-group">
                            <label for="yorum-puan">Puanınız <span class="rs-vurgu" aria-hidden="true">*</span></label>
                            <select id="yorum-puan" name="Puan" required>
                                <option value="" disabled selected>Puan seçiniz...</option>
                                <option value="5">5 yıldız — Mükemmel</option>
                                <option value="4">4 yıldız — Çok iyi</option>
                                <option value="3">3 yıldız — İyi</option>
                                <option value="2">2 yıldız — Orta</option>
                                <option value="1">1 yıldız — Geliştirilmeli</option>
                            </select>
                        </div>
                        <div class="form-group full-width">
                            <label for="yorum-mesaj">Yorumunuz <span class="rs-vurgu" aria-hidden="true">*</span></label>
                            <textarea id="yorum-mesaj" name="Mesaj" rows="4" placeholder="Deneyiminizi birkaç cümleyle anlatın..." maxlength="1000" required></textarea>
                        </div>
                        <button type="submit" class="btn-main full-width">Yorumu Gönder</button>
                    </form>
                    </div>
                </div>
            </div>
        </section>

        <section id="contact" class="section-padding">
            <div class="container">
                <div class="bolum-basi">
                    <p class="bolum-ustbaslik">İletişim</p>
                    <h2 class="section-title">Sizi Bekliyoruz</h2>
                    <p class="bolum-alt-metin">Masanızı ayırtın ya da aklınıza takılanı sorun — aynı gün dönüş yapıyoruz.</p>
                </div>

                <div class="iletisim-duzen">
                    <aside class="iletisim-bilgi">
                        <div class="bilgi-kart">
                            <ul class="bilgi-liste">
                                <li>
                                    <span class="bilgi-ikon"><i class="fas fa-location-dot" aria-hidden="true"></i></span>
                                    <div>
                                        <strong>Adres</strong>
                                        <p>Yeni Mahalle, 21002 Sokak No: 3B<br>10200 Bandırma / Balıkesir</p>
                                        <a class="bilgi-eylem" target="_blank" rel="noopener"
                                           href="https://www.google.com/maps/dir/?api=1&amp;destination=Rosso+lounge+bistro+Bandırma">
                                            Yol tarifi al <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </li>
                                <li>
                                    <span class="bilgi-ikon"><i class="fas fa-phone" aria-hidden="true"></i></span>
                                    <div>
                                        <strong>Telefon</strong>
                                        <p><a href="tel:+902667121313">+90 266 712 13 13</a></p>
                                    </div>
                                </li>
                                <li>
                                    <span class="bilgi-ikon"><i class="fas fa-clock" aria-hidden="true"></i></span>
                                    <div>
                                        <strong>Çalışma Saatleri</strong>
                                        <p>Her gün 11.30 – 00.00</p>
                                        @if (ViewBag.SuAnAcik is bool acikMi)
                                        {
                                            <span class="durum-rozet @(acikMi ? "acik" : "kapali")">
                                                <span class="durum-nokta" aria-hidden="true"></span>
                                                @(acikMi ? "Şu an açığız" : "Şu an kapalıyız")
                                            </span>
                                        }
                                    </div>
                                </li>
                                <li>
                                    <span class="bilgi-ikon"><i class="fas fa-envelope" aria-hidden="true"></i></span>
                                    <div>
                                        <strong>E-Posta</strong>
                                        <p><a href="mailto:info@@rossolounge.com">info@@rossolounge.com</a></p>
                                    </div>
                                </li>
                            </ul>

                            <div class="sosyal-satir">
                                <a href="https://www.instagram.com/rosso.lounge.bistro/" target="_blank" rel="noopener" aria-label="Instagram sayfamız">
                                    <i class="fab fa-instagram" aria-hidden="true"></i>
                                </a>
                                <a href="https://www.facebook.com/rossolounge" target="_blank" rel="noopener" aria-label="Facebook sayfamız">
                                    <i class="fab fa-facebook-f" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>

                        <div class="harita-kutu">
                            <iframe title="Rosso Lounge Bistro konumu"
                                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d319.6543230992864!2d27.936944127683113!3d40.34053662812616!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14b5d3bd385d1797%3A0x887916a4f8a71e73!2sRosso%20lounge%20bistro!5e0!3m2!1str!2str!4v1763491907694!5m2!1str!2str"
                                    loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                        </div>
                    </aside>

                    <div class="form-panel" id="rezervasyon">
                        <div class="form-sekmeler" role="tablist" aria-label="İletişim biçimi">
                            <button type="button" class="form-sekme aktif" role="tab" id="sekme-rezervasyon"
                                    aria-selected="true" aria-controls="panel-rezervasyon">
                                <i class="fas fa-calendar-check" aria-hidden="true"></i> Masa Ayırt
                            </button>
                            <button type="button" class="form-sekme" role="tab" id="sekme-mesaj"
                                    aria-selected="false" aria-controls="panel-mesaj" tabindex="-1">
                                <i class="fas fa-paper-plane" aria-hidden="true"></i> Mesaj Gönder
                            </button>
                        </div>

                        <div class="form-govde" role="tabpanel" id="panel-rezervasyon" aria-labelledby="sekme-rezervasyon" tabindex="0">
                            <p class="form-aciklama">Özel günleriniz veya akşam yemeğiniz için yerinizi şimdiden ayırtın.</p>
                            <form id="reservation-form" class="alan-izgara" method="post" action="/Home/RezervasyonYap">
                                @Html.AntiForgeryToken()
                                <div class="form-group">
                                    <label for="rez-ad">Ad Soyad <span class="rs-vurgu" aria-hidden="true">*</span></label>
                                    <input type="text" id="rez-ad" name="AdSoyad" placeholder="Adınız ve soyadınız"
                                           autocomplete="name" maxlength="100" required>
                                </div>
                                <div class="form-group">
                                    <label for="phoneInput">Telefon <span class="rs-vurgu" aria-hidden="true">*</span></label>
                                    <input type="tel" id="phoneInput" name="Telefon" placeholder="5XX XXX XX XX"
                                           autocomplete="tel" inputmode="numeric" maxlength="10"
                                           aria-describedby="telefon-yardim" required>
                                    <small id="telefon-yardim" class="rs-soluk">Başında '0' olmadan 10 hane.</small>
                                </div>
                                <div class="form-group">
                                    <label for="datePicker">Tarih ve Saat <span class="rs-vurgu" aria-hidden="true">*</span></label>
                                    <input type="text" id="datePicker" name="Tarih" placeholder="Tarih ve saat seçiniz" required>
                                </div>
                                <div class="form-group">
                                    <label for="rez-kisi">Kişi Sayısı <span class="rs-vurgu" aria-hidden="true">*</span></label>
                                    <input type="number" id="rez-kisi" name="KisiSayisi" placeholder="Örn: 4" min="1" max="100" required>
                                </div>
                                <div class="form-group full-width">
                                    <label for="rez-not">Özel Notunuz <span class="rs-soluk">(opsiyonel)</span></label>
                                    <textarea id="rez-not" name="Not" rows="3" placeholder="Doğum günü, alerji, pencere kenarı..." maxlength="500"></textarea>
                                </div>
                                <button type="submit" class="btn-main full-width">Rezervasyonu Tamamla</button>
                            </form>
                        </div>

                        <div class="form-govde" role="tabpanel" id="panel-mesaj" aria-labelledby="sekme-mesaj" tabindex="0" hidden>
                            <p class="form-aciklama">Soru, öneri veya özel organizasyon talepleriniz için yazın.</p>
                            <form class="alan-izgara" method="post" action="/Home/IletisimGonder">
                                @Html.AntiForgeryToken()
                                <div class="form-group">
                                    <label for="iletisim-ad">Ad Soyad <span class="rs-vurgu" aria-hidden="true">*</span></label>
                                    <input type="text" id="iletisim-ad" name="AdSoyad" placeholder="Adınız ve soyadınız"
                                           autocomplete="name" maxlength="100" required>
                                </div>
                                <div class="form-group">
                                    <label for="iletisim-eposta">E-Posta <span class="rs-vurgu" aria-hidden="true">*</span></label>
                                    <input type="email" id="iletisim-eposta" name="Email" placeholder="ornek@@eposta.com"
                                           autocomplete="email" maxlength="150" required>
                                </div>
                                <div class="form-group full-width">
                                    <label for="iletisim-telefon">Telefon <span class="rs-soluk">(opsiyonel)</span></label>
                                    <input type="tel" id="iletisim-telefon" name="Telefon" placeholder="0 5XX XXX XX XX"
                                           autocomplete="tel" maxlength="25">
                                </div>
                                <div class="form-group full-width">
                                    <label for="iletisim-mesaj">Mesajınız <span class="rs-vurgu" aria-hidden="true">*</span></label>
                                    <textarea id="iletisim-mesaj" name="Mesaj" rows="5" placeholder="Size nasıl yardımcı olabiliriz?"
                                              minlength="5" maxlength="2000" required></textarea>
                                </div>
                                <button type="submit" class="btn-main full-width">Mesajı Gönder</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="alt-izgara">
                <div class="alt-marka">
                    <a href="#home" class="logo">ROSSO <span>LOUNGE</span></a>
                    <p>Marmara kıyısında, iyi bir sohbetin hak ettiği tabaklar.<br>Bandırma'da 2019'dan beri.</p>
                    <div class="sosyal-satir">
                        <a href="https://www.instagram.com/rosso.lounge.bistro/" target="_blank" rel="noopener" aria-label="Instagram sayfamız">
                            <i class="fab fa-instagram" aria-hidden="true"></i>
                        </a>
                        <a href="https://www.facebook.com/rossolounge" target="_blank" rel="noopener" aria-label="Facebook sayfamız">
                            <i class="fab fa-facebook-f" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <nav class="alt-sutun" aria-label="Alt bilgi menüsü">
                    <h3>Keşfet</h3>
                    <ul>
                        <li><a href="#about">Hakkımızda</a></li>
                        <li><a href="/Home/Menu">Menü</a></li>
                        <li><a href="#gallery">Galeri</a></li>
                        <li><a href="#reviews">Yorumlar</a></li>
                        <li><a href="#rezervasyon">Rezervasyon</a></li>
                    </ul>
                </nav>

                <div class="alt-sutun">
                    <h3>Ziyaret</h3>
                    <ul>
                        <li><a href="https://www.google.com/maps/dir/?api=1&amp;destination=Rosso+lounge+bistro+Bandırma" target="_blank" rel="noopener">Yeni Mahalle, 21002 Sokak No: 3B<br>Bandırma / Balıkesir</a></li>
                        <li><a href="tel:+902667121313">+90 266 712 13 13</a></li>
                        <li><a href="mailto:info@@rossolounge.com">info@@rossolounge.com</a></li>
                    </ul>
                </div>

                <div class="alt-sutun">
                    <h3>Saatler</h3>
                    <ul>
                        <li>Her gün <strong>11.30 – 00.00</strong></li>
                        @if (ViewBag.SuAnAcik is bool altAcik)
                        {
                            <li>
                                <span class="durum-rozet @(altAcik ? "acik" : "kapali")">
                                    <span class="durum-nokta" aria-hidden="true"></span>
                                    @(altAcik ? "Şu an açığız" : "Şu an kapalıyız")
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="alt-serit">
                <p>&copy; @yil Rosso Lounge Bistro. Tüm hakları saklıdır.</p>
                <div class="footer-signature">Software &amp; Design by <span class="developer-name">Mert CEREN</span></div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>
    <!-- Sahne motoru bagimliliklar — rosso-hareket.js'ten ONCE.
         Yuklenemezlerse site animasyonsuz ama tam okunur acilir. -->
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.20/dist/lenis.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/Flip.min.js"></script>
    <script src="~/js/rosso-hareket.js" asp-append-version="true"></script>
    <script src="~/js/ortak.js" asp-append-version="true"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
</body>
</html>
