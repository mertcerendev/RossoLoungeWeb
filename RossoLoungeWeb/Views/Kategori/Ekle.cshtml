@model RossoLoungeWeb.Models.Kategori
@*
    KATEGORİ EKLE
    ===============================================================
    Uç değişmedi: POST /Kategori/Ekle (Ad, SiraNo).
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Yeni Kategori";
    ViewData["AltBaslik"] = "Menüye yeni bir kategori ekleyin";
    ViewData["Aktif"] = "kategoriler";
}

@section Eylemler {
    <a class="y-dugme" href="/Kategori/Index">
        <i class="fas fa-arrow-left" aria-hidden="true"></i> Listeye dön
    </a>
}

@await Html.PartialAsync("_YonetimDogrulama")

<form class="y-form" method="post" action="/Kategori/Ekle">
    @Html.AntiForgeryToken()

    <div class="y-form__izgara">
        <div class="y-form__alan">
            <label class="y-form__etiket" for="siraNo">
                Sıra no <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            <input class="y-girdi y-girdi--sayi" type="number" id="siraNo" name="SiraNo"
                   value="@Model?.SiraNo" min="1" required aria-describedby="siraNo-yardim">
            <p class="y-form__yardim" id="siraNo-yardim">Menüde hangi sırada görünsün? (1: en üst)</p>
        </div>

        <div class="y-form__alan">
            <label class="y-form__etiket" for="ad">
                Kategori adı <span class="y-zorunlu" aria-hidden="true">*</span>
            </label>
            <input class="y-girdi" type="text" id="ad" name="Ad"
                   value="@Model?.Ad" placeholder="Örn: Pizzalar" maxlength="100" required>
        </div>
    </div>

    <div class="y-form__ayak">
        <button type="submit" class="y-dugme y-dugme--birincil">Kaydet</button>
        <a class="y-dugme" href="/Kategori/Index">İptal</a>
    </div>
</form>
