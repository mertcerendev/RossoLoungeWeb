@model RossoLoungeWeb.Models.Kategori
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Kategori Düzenle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">

    <div class="card shadow p-4" style="width: 400px;">
        <h4 class="mb-3 text-center">Kategori Düzenle</h4>

        <form action="/Kategori/Duzenle" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label">Sıra No:</label>
                <input type="number" name="SiraNo" class="form-control" required value="@Model.SiraNo">
            </div>

            <div class="mb-3">
                <label class="form-label">Kategori Adı:</label>
                <input type="text" name="Ad" class="form-control" required value="@Model.Ad">
            </div>

            <button type="submit" class="btn btn-primary w-100">Güncelle</button>
        </form>

        <a href="/Kategori/Index" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
    </div>

</body>
</html>