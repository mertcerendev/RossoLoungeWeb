@model List<RossoLoungeWeb.Models.Kategori>
@*
    KATEGORİLER
    ===============================================================
    Uçlar değişmedi: POST /Kategori/SiraGuncelle (sürükle-bırak),
    POST /Kategori/Sil/{id}, /Kategori/Ekle, /Kategori/Duzenle/{id}.

    SIRALAMA KORUNDU: tutamak + SortableJS + klavye (ok tuşları).
    Sunucu yalnızca gönderilen kayıtların mevcut sıra numaralarını
    kendi aralarında yeniden dağıtır.
*@
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Baslik"] = "Kategoriler";
    ViewData["AltBaslik"] = "Menü kategorilerini yönetin ve sıralayın";
    ViewData["Aktif"] = "kategoriler";
    ViewData["AramaHedefi"] = "kategori-tablosu";
    ViewData["AramaYerTutucu"] = "Kategori adında ara";

    var urunSayilari = ViewBag.UrunSayilari as Dictionary<int, int> ?? new Dictionary<int, int>();
}

@section Eylemler {
    <span class="y-rozet y-rozet--sonuk">
        Toplam <span data-tablo-sayac>@Model.Count</span>
    </span>
    <a class="y-dugme y-dugme--birincil" href="/Kategori/Ekle">
        <i class="fas fa-plus" aria-hidden="true"></i> Yeni Kategori
    </a>
}

@if (Model.Count == 0)
{
    <div class="y-bos">
        <i class="y-bos__im fas fa-layer-group" aria-hidden="true"></i>
        <h2 class="y-bos__baslik">Henüz kategori yok</h2>
        <p class="y-bos__alt">Menüye ürün ekleyebilmek için önce en az bir kategori oluşturun.</p>
        <p class="y-bos__eylem">
            <a class="y-dugme y-dugme--birincil" href="/Kategori/Ekle">İlk kategoriyi ekle</a>
        </p>
    </div>
}
else
{
    <p class="y-sira-durum" role="status" aria-live="polite"></p>
    <div hidden>@Html.AntiForgeryToken()</div>

    <div class="y-tablo-sarmal">
        <table class="y-tablo" id="kategori-tablosu">
            <caption class="y-gizli">Menü kategorileri. Sıralama tutamakla sürüklenerek ya da ok tuşlarıyla değiştirilir.</caption>
            <thead>
                <tr>
                    <th scope="col" class="y-tablo__dar">Sıra</th>
                    <th scope="col">Kategori</th>
                    <th scope="col">Ürün</th>
                    <th scope="col" class="y-tablo__eylem"><span class="y-gizli">İşlemler</span></th>
                </tr>
            </thead>
            <tbody class="y-siralanabilir" data-sira-url="/Kategori/SiraGuncelle">
                @foreach (var item in Model)
                {
                    urunSayilari.TryGetValue(item.Id, out int adet);

                    <tr data-id="@item.Id">
                        <td class="y-tablo__dar">
                            <div class="y-sira">
                                <button type="button" class="y-sira__tut"
                                        aria-label="@item.Ad sırasını değiştir. Sürükleyin veya yukarı/aşağı ok tuşlarını kullanın."
                                        title="Sürükleyerek sırala">
                                    <i class="fas fa-grip-vertical" aria-hidden="true"></i>
                                </button>
                                <span class="y-sira__no y-sayi">@item.SiraNo</span>
                            </div>
                        </td>
                        <td>
                            <span class="y-tablo__ad">@item.Ad</span>
                            @* Boş kategori menüde HİÇ basılmıyor (HomeController.Menu →
                               Where(k => k.Urunler.Any())). Panelde duruyor ama sitede
                               yok; yöneticinin bunu listeden görmesi gerekiyor. *@
                            @if (adet == 0)
                            {
                                <span class="y-tablo__ikincil">Menüde görünmüyor — içi boş</span>
                            }
                        </td>
                        <td>
                            @if (adet > 0)
                            {
                                <a class="y-rozet" href="/Urun/Index?kategoriId=@item.Id">@adet ürün</a>
                            }
                            else
                            {
                                <span class="y-tablo__ikincil">—</span>
                            }
                        </td>
                        <td class="y-tablo__eylem">
                            <div class="y-eylemler">
                                <a class="y-hayalet" href="/Kategori/Duzenle/@item.Id"
                                   title="Düzenle" aria-label="@item.Ad kategorisini düzenle">
                                    <i class="fas fa-pen" aria-hidden="true"></i>
                                </a>

                                @* Dolu kategori zaten SİLİNEMİYOR: ilişki Restrict,
                                   KategoriController.Sil ürün sayısını önden kontrol
                                   edip hata mesajıyla geri çeviriyor. Düğme etkin
                                   kalınca yol "tıkla → onayla → kırmızı uyarı" oluyordu;
                                   sonucu baştan söylemek daha dürüst.
                                   Sunucu kontrolü YERİNDE DURUYOR — burası yalnızca kabuk. *@
                                @if (adet > 0)
                                {
                                    <span class="y-hayalet y-hayalet--pasif"
                                          aria-disabled="true"
                                          title="Silinemez: içinde @adet ürün var. Önce ürünleri başka kategoriye taşıyın.">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                        <span class="y-gizli">@item.Ad silinemez, içinde @adet ürün var</span>
                                    </span>
                                }
                                else
                                {
                                    @* Onay metnine ad gömülmüyor: kesme işareti taşıyan bir
                                       kategori adı ("Şef'in Seçimi") JS dizesini kırar. *@
                                    <form method="post" action="/Kategori/Sil/@item.Id"
                                          onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="y-hayalet y-hayalet--tehlike"
                                                aria-label="@item.Ad kategorisini sil"
                                                title="Sil">
                                            <i class="fas fa-trash-can" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Kutuphaneler {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
}
